---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import prisma from '../lib/prisma';

let totalOrganizadoras = 0;
let totalEditais = 0;
let editaisPendentes = 0;
let ultimosEditais = [];
let errorMsg = null;

try {
  totalOrganizadoras = await prisma.organizadora.count({ where: { ativo: true } });
  
  const allValidEditais = await prisma.edital.findMany({
    where: { is_valido: true },
    orderBy: { data_download: 'desc' },
    include: { organizadora: true, concursos: true }
  });
  
  const hoje = new Date();
  const vigentes = allValidEditais.filter(edital => {
    if (edital.concursos && edital.concursos.length > 0) {
      const concurso = edital.concursos[0];
      if (concurso.inscricao_fim) {
        const dataFim = new Date(concurso.inscricao_fim);
        dataFim.setHours(23, 59, 59, 999);
        if (dataFim < hoje) {
          return false;
        }
      }
    }
    return true;
  });
  
  totalEditais = vigentes.length;
  
  editaisPendentes = await prisma.edital.count({ 
    where: { 
      status_processamento: 'pendente',
      is_valido: true 
    } 
  });
  
  // Para exibir apenas os últimos coletados que ainda estão vigentes ou pendentes
  ultimosEditais = vigentes.slice(0, 5);
} catch (err) {
  console.error('Erro ao carregar Dashboard:', err);
  errorMsg = err instanceof Error ? err.message : String(err);
}
---

<DashboardLayout title="Geral">
  {errorMsg && (
    <div class="glass-card p-6 border-red-200 bg-red-50 text-red-700 mb-8">
      <h3 class="font-bold mb-2">Erro de Conexão com o Banco</h3>
      <p class="text-sm font-mono">{errorMsg}</p>
    </div>
  )}

	<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="glass-card p-6 flex flex-col gap-2">
      <span class="text-slate-500 text-xs font-semibold uppercase tracking-wider">Bancas Ativas</span>
      <div class="flex items-baseline gap-2">
        <span class="text-4xl font-outfit font-extrabold text-slate-900 tracking-tight">{totalOrganizadoras}</span>
      </div>
    </div>
    <div class="glass-card p-6 flex flex-col gap-2">
      <span class="text-slate-500 text-xs font-semibold uppercase tracking-wider">Editais Válidos</span>
      <div class="flex items-baseline gap-2">
        <span class="text-4xl font-outfit font-extrabold text-slate-900 tracking-tight">{totalEditais}</span>
      </div>
    </div>
    <div class="glass-card p-6 flex flex-col gap-2 border-amber-200/60 bg-amber-50/10">
      <span class="text-slate-500 text-xs font-semibold uppercase tracking-wider">Aguardando IA</span>
      <div class="flex items-baseline gap-2">
        <span class="text-4xl font-outfit font-extrabold text-amber-600 tracking-tight">{editaisPendentes}</span>
      </div>
    </div>
  </div>

  <div class="glass-card overflow-hidden">
    <div class="px-6 py-4.5 border-b border-slate-100 flex justify-between items-center bg-slate-50/30">
      <h3 class="font-outfit font-bold text-sm text-slate-800">Últimos Editais Coletados</h3>
      <a href="/editais" class="text-[10px] text-indigo-600 hover:text-indigo-700 font-bold uppercase tracking-wider">Ver todos</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="text-[10px] text-slate-400 uppercase tracking-widest bg-slate-50/50">
            <th class="px-6 py-4.5 font-bold">Banca</th>
            <th class="px-6 py-4.5 font-bold">Concurso / Órgão</th>
            <th class="px-6 py-4.5 font-bold">Data Coleta</th>
            <th class="px-6 py-4.5 font-bold">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {ultimosEditais.map(edital => (
            <tr class="hover:bg-slate-50/40 transition-colors group">
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 bg-indigo-50 border border-indigo-100 text-indigo-600 text-[8px] font-bold rounded uppercase tracking-wider font-mono">
                  {edital.organizadora.nome}
                </span>
              </td>
              <td class="px-6 py-4 text-slate-700">
                {edital.status_processamento === 'processado' ? (
                  <a href={`/concursos/${edital.concursos[0]?.id}`} class="text-sm font-semibold text-slate-800 hover:text-indigo-600 transition-colors truncate max-w-md block">
                    {edital.nome_edital}
                  </a>
                ) : (
                  <p class="text-sm font-medium truncate max-w-md text-slate-500">{edital.nome_edital}</p>
                )}
              </td>
              <td class="px-6 py-4 text-xs text-slate-400 font-mono">
                {edital.data_download ? new Date(edital.data_download).toLocaleDateString('pt-BR') : '-'}
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                   <span class={`w-1.5 h-1.5 rounded-full ${
                    edital.status_processamento === 'pendente' ? 'bg-amber-500' : 'bg-emerald-500'
                  }`}></span>
                  <span class={`text-[9px] font-extrabold rounded uppercase tracking-wider ${
                    edital.status_processamento === 'pendente' ? 'text-amber-600' : 'text-emerald-600'
                  }`}>
                    {edital.status_processamento}
                  </span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>
