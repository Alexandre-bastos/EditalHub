---
import prisma from '../lib/prisma';
import { hashPassword, verifyPassword } from '../lib/auth';
import { encryptSession } from '../lib/session';
import '../styles/global.css';


let errorMessage = '';
let seedMessage = '';

// Auto-seeding: verifica se não existem usuários no banco e cria o administrador padrão
try {
  const userCount = await prisma.usuario.count();
  if (userCount === 0) {
    const adminEmail = 'admin@editalhub.com';
    const adminPassword = 'admin123';
    const hashedPassword = hashPassword(adminPassword);
    
    await prisma.usuario.create({
      data: {
        nome: 'Administrador Padrão',
        email: adminEmail,
        senha_hash: hashedPassword,
        ativo: true
      }
    });

    seedMessage = `Nenhum usuário encontrado. Criamos a conta de Administrador Padrão para o seu primeiro acesso. Use: admin@editalhub.com / senha: admin123 (lembre-se de mudar ou excluir essa conta no painel).`;
  }
} catch (e: any) {
  console.error('Erro no auto-seeding de usuário:', e.message);
}

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get('email')?.toString().trim().toLowerCase();
    const password = formData.get('password')?.toString() || '';

    if (!email || !password) {
      errorMessage = 'Por favor, preencha todos os campos.';
    } else {
      // Busca o usuário no banco de dados Azure SQL
      const user = await prisma.usuario.findUnique({
        where: { email }
      });

      if (!user) {
        errorMessage = 'E-mail ou senha incorretos.';
      } else if (!user.ativo) {
        errorMessage = 'Esta conta de usuário está desativada no momento.';
      } else {
        // Valida a senha usando a criptografia timing-safe
        const isValid = verifyPassword(password, user.senha_hash);
        
        if (!isValid) {
          errorMessage = 'E-mail ou senha incorretos.';
        } else {
          // Cria a sessão assinada e injeta o cookie HTTP-Only seguro
          const sessionToken = encryptSession({
            id: user.id,
            email: user.email,
            nome: user.nome
          });

          Astro.cookies.set('session', sessionToken, {
            path: '/',
            httpOnly: true,
            secure: true,
            sameSite: 'lax',
            maxAge: 60 * 60 * 24 * 7 // 7 dias
          });

          // Redireciona para o dashboard principal
          return Astro.redirect('/');
        }
      }
    }
  } catch (error: any) {
    errorMessage = `Erro no servidor: ${error.message}`;
  }
}
---

<!doctype html>
<html lang="pt-br" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="EditalHub - Login de Acesso" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Entrar | EditalHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#070708] text-gray-100 font-inter min-h-screen flex items-center justify-center relative overflow-hidden">
    
    <!-- Efeitos decorativos em degrade de fundo (Premium Glow) -->
    <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-900/10 blur-[150px] -z-10"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-900/10 blur-[150px] -z-10"></div>

    <div class="w-full max-w-md px-6 py-12">
      <!-- Cabeçalho de Logo -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-outfit font-extrabold bg-gradient-to-r from-blue-400 via-indigo-400 to-indigo-600 bg-clip-text text-transparent tracking-tight">
          EditalHub
        </h1>
        <p class="text-xs text-gray-400 uppercase tracking-widest mt-2 font-medium">Gestão Inteligente de Editais</p>
      </div>

      <!-- Card de Login Glassmorphism -->
      <div class="bg-[#0c0c0e]/60 backdrop-blur-xl border border-white/5 p-8 rounded-3xl shadow-2xl shadow-black/40">
        <h2 class="text-xl font-outfit font-bold text-white mb-2">Acesse a sua conta</h2>
        <p class="text-sm text-gray-400 mb-6">Insira suas credenciais para gerenciar o painel.</p>

        <!-- Banner de Informação do Seeding (Primeiro Acesso) -->
        {seedMessage && (
          <div class="bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs p-4 rounded-2xl mb-6 flex flex-col gap-1.5 leading-relaxed">
            <span class="font-bold flex items-center gap-1 text-indigo-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              Primeiro Acesso Detectado:
            </span>
            <span>{seedMessage}</span>
          </div>
        )}

        <!-- Banner de Mensagem de Erro -->
        {errorMessage && (
          <div class="bg-red-500/10 border border-red-500/20 text-red-400 text-xs p-3.5 rounded-2xl mb-6 font-medium flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>{errorMessage}</span>
          </div>
        )}

        <!-- Formulário -->
        <form method="POST" class="space-y-5">
          <div>
            <label for="email" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">E-mail</label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required 
              placeholder="exemplo@editalhub.com"
              class="w-full bg-[#111113] border border-white/5 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-blue-500/40 focus:ring-1 focus:ring-blue-500/20 transition-all font-medium"
            />
          </div>

          <div>
            <div class="flex justify-between items-center mb-2">
              <label for="password" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Senha</label>
            </div>
            <input 
              type="password" 
              name="password" 
              id="password" 
              required 
              placeholder="••••••••"
              class="w-full bg-[#111113] border border-white/5 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-blue-500/40 focus:ring-1 focus:ring-blue-500/20 transition-all font-medium"
            />
          </div>

          <button 
            type="submit" 
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-xl transition-all shadow-lg shadow-blue-900/20 active:scale-[0.98] mt-2 cursor-pointer flex items-center justify-center gap-2"
          >
            Entrar no Painel
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </form>
      </div>

      <p class="text-center text-xs text-gray-600 mt-8">
        &copy; {new Date().getFullYear()} EditalHub. Todos os direitos reservados.
      </p>
    </div>
  </body>
</html>

<style is:global>
  .font-outfit { font-family: 'Outfit', sans-serif; }
  .font-inter { font-family: 'Inter', sans-serif; }
</style>
