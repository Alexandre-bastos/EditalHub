---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import prisma from '../../lib/prisma';

const { id } = Astro.params;

// Buscar dados do concurso e vagas
const concurso = await prisma.concurso.findUnique({
  where: { id },
  include: { 
    edital: { include: { organizadora: true } },
    cargos: true 
  }
});

if (!concurso) {
  return Astro.redirect('/editais');
}

// Lógica de Salvamento (POST)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'update_concurso') {
    await prisma.concurso.update({
      where: { id },
      data: {
        nome_concurso: formData.get('nome_concurso')?.toString() || '',
        estado: formData.get('estado')?.toString(),
        taxa_inscricao: parseFloat(formData.get('taxa_inscricao')?.toString() || '0'),
        salario_inicial: parseFloat(formData.get('salario_inicial')?.toString() || '0'),
        inscricao_inicio: formData.get('inscricao_inicio') ? new Date(formData.get('inscricao_inicio')!.toString()) : null,
        inscricao_fim: formData.get('inscricao_fim') ? new Date(formData.get('inscricao_fim')!.toString()) : null,
        data_prova: formData.get('data_prova') ? new Date(formData.get('data_prova')!.toString()) : null,
      }
    });
    return Astro.redirect(`/concursos/${id}?success=true`);
  }
}

const success = Astro.url.searchParams.get('success') === 'true';
---

<DashboardLayout title="Detalhes do Concurso">
  <div class="mb-6 flex items-center gap-4">
    <a href="/editais" class="text-gray-500 hover:text-white transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </a>
    <span class="px-3 py-1 bg-blue-500/10 text-blue-400 text-[10px] font-bold rounded uppercase">
      {concurso.edital.organizadora.nome}
    </span>
  </div>

  {success && (
    <div class="bg-green-500/10 border border-green-500/20 text-green-500 px-4 py-3 rounded-xl mb-8 text-sm">
      Alterações salvas com sucesso!
    </div>
  )}

  <form method="POST" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <input type="hidden" name="action" value="update_concurso" />
    
    <!-- Informações Gerais -->
    <div class="lg:col-span-2 space-y-6">
      <div class="glass-card p-8">
        <h3 class="font-outfit font-semibold text-lg mb-6">Informações Extraídas</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <label class="block text-xs text-gray-500 uppercase tracking-widest mb-2">Título do Concurso</label>
            <input name="nome_concurso" type="text" value={concurso.nome_concurso} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
          </div>
          
          <div>
            <label class="block text-xs text-gray-500 uppercase tracking-widest mb-2">Estado (UF)</label>
            <input name="estado" type="text" value={concurso.estado} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
          </div>
          
          <div>
            <label class="block text-xs text-gray-500 uppercase tracking-widest mb-2">Taxa de Inscrição (R$)</label>
            <input name="taxa_inscricao" type="number" step="0.01" value={concurso.taxa_inscricao?.toString()} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
          </div>

          <div>
            <label class="block text-xs text-gray-500 uppercase tracking-widest mb-2">Data da Prova</label>
            <input name="data_prova" type="date" value={concurso.data_prova?.toISOString().split('T')[0]} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
          </div>

          <div>
            <label class="block text-xs text-gray-500 uppercase tracking-widest mb-2">Salário Inicial Médio</label>
            <input name="salario_inicial" type="number" step="0.01" value={concurso.salario_inicial?.toString()} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
          </div>

          <div>
            <label class="block text-xs text-gray-500 uppercase tracking-widest mb-2">Inscrições (Início)</label>
            <input name="inscricao_inicio" type="date" value={concurso.inscricao_inicio?.toISOString().split('T')[0]} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
          </div>

          <div>
            <label class="block text-xs text-gray-500 uppercase tracking-widest mb-2">Inscrições (Fim)</label>
            <input name="inscricao_fim" type="date" value={concurso.inscricao_fim?.toISOString().split('T')[0]} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/5 flex justify-end">
          <button type="submit" class="btn-primary">Salvar Alterações</button>
        </div>
      </div>

      <!-- Tabela de Cargos -->
      <div class="glass-card overflow-hidden">
        <div class="px-8 py-6 border-b border-white/5 bg-white/[0.01] flex justify-between items-center">
          <h3 class="font-outfit font-semibold">Cargos e Vagas</h3>
          <button type="button" class="text-xs text-blue-400 hover:underline">+ Adicionar Cargo</button>
        </div>
        <table class="w-full text-left">
          <thead>
            <tr class="text-[10px] text-gray-500 uppercase tracking-widest bg-white/[0.02]">
              <th class="px-8 py-4 font-medium">Cargo</th>
              <th class="px-8 py-4 font-medium">Escolaridade</th>
              <th class="px-8 py-4 font-medium">Salário</th>
              <th class="px-8 py-4 font-medium">Vagas</th>
              <th class="px-8 py-4 font-medium">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {concurso.cargos.map(cargo => (
              <tr class="hover:bg-white/[0.01]">
                <td class="px-8 py-4 text-sm font-medium">{cargo.nome_cargo}</td>
                <td class="px-8 py-4 text-xs text-gray-400">{cargo.escolaridade}</td>
                <td class="px-8 py-4 text-sm">R$ {cargo.salario?.toString()}</td>
                <td class="px-8 py-4 text-sm">{cargo.quantidade}</td>
                <td class="px-8 py-4">
                  <button type="button" class="text-xs text-gray-500 hover:text-white">Editar</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Sidebar de Arquivo -->
    <div class="space-y-6">
      <div class="glass-card p-6">
        <h4 class="text-sm font-semibold mb-4">Arquivo Original</h4>
        <div class="aspect-[3/4] bg-white/[0.03] rounded-xl border border-white/10 flex flex-col items-center justify-center p-6 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-500/50 mb-4"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14.5 2 14.5 7 20 7"/></svg>
          <p class="text-xs text-gray-400 mb-4">{concurso.edital.nome_edital}</p>
          <a 
            href={`https://storageappvidanavida.blob.core.windows.net/editalhub/${concurso.edital.nome_arquivo}`} 
            target="_blank" 
            class="text-xs bg-white/10 hover:bg-white/20 px-4 py-2 rounded-lg transition-all"
          >
            Abrir PDF
          </a>
        </div>
      </div>
    </div>
  </form>
</DashboardLayout>
