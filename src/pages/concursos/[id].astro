---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import prisma from '../../lib/prisma';
import { createAuditLog } from '../../services/audit';

const currentUser = Astro.locals.user;
if (!currentUser) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;
const editalId = Astro.url.searchParams.get('edital');

let concurso = null;

if (editalId) {
  // Modo de criação: Tentar encontrar ou criar um concurso para este edital
  concurso = await prisma.concurso.findFirst({
    where: { edital_id: editalId },
    include: { 
      edital: { include: { organizadora: true } },
      cargos: true 
    }
  });

  if (!concurso) {
    // Criar um registro em branco
    concurso = await prisma.concurso.create({
      data: {
        edital_id: editalId,
        nome_concurso: 'Novo Concurso',
      },
      include: { 
        edital: { include: { organizadora: true } },
        cargos: true 
      }
    });

    // Registra na trilha de auditoria a criação manual do concurso
    await createAuditLog(
      currentUser.id,
      currentUser.nome,
      'Criou Concurso',
      'Concurso',
      concurso.id,
      `Criou manualmente a ficha de dados para o edital "${concurso.edital.nome_edital}"`
    );

    // Atualizar status do edital para não ficar "pendente" se estamos editando manual
    await prisma.edital.update({
      where: { id: editalId },
      data: { status_processamento: 'processado' }
    });
  }
} else {
  // Modo de edição padrão pelo ID do concurso
  concurso = await prisma.concurso.findUnique({
    where: { id },
    include: { 
      edital: { include: { organizadora: true } },
      cargos: true 
    }
  });
}

if (!concurso) {
  return Astro.redirect('/editais');
}

// Lógica de Salvamento (POST)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'update_concurso') {
    const nome_concurso = formData.get('nome_concurso')?.toString() || '';
    const estado = formData.get('estado')?.toString() || null;
    const taxa_inscricao = formData.get('taxa_inscricao') ? parseFloat(formData.get('taxa_inscricao')!.toString()) : null;
    const salario_inicial = formData.get('salario_inicial') ? parseFloat(formData.get('salario_inicial')!.toString()) : null;
    const inscricao_inicio = formData.get('inscricao_inicio') ? new Date(formData.get('inscricao_inicio')!.toString()) : null;
    const inscricao_fim = formData.get('inscricao_fim') ? new Date(formData.get('inscricao_fim')!.toString()) : null;
    const data_prova = formData.get('data_prova') ? new Date(formData.get('data_prova')!.toString()) : null;
    const escolaridade = formData.get('escolaridade')?.toString() || null;
    const formacao = formData.get('formacao')?.toString() || null;
    const profissao = formData.get('profissao')?.toString() || null;
    const registro_profissional = formData.get('registro_profissional')?.toString() || null;
    const idade_minima = formData.get('idade_minima') ? parseInt(formData.get('idade_minima')!.toString()) : null;
    const idade_maxima = formData.get('idade_maxima') ? parseInt(formData.get('idade_maxima')!.toString()) : null;
    const link_inscricao = formData.get('link_inscricao')?.toString() || null;
    const resumo = formData.get('resumo')?.toString() || null;

    // Constrói o histórico de alterações (diff)
    const changes: string[] = [];
    const getDiff = (field: string, oldVal: any, newVal: any) => {
      if (String(oldVal || '') !== String(newVal || '')) {
        changes.push(`• **${field}**: de "${oldVal || 'vazio'}" para "${newVal || 'vazio'}"`);
      }
    };

    getDiff('Título', concurso.nome_concurso, nome_concurso);
    getDiff('Estado', concurso.estado, estado);
    getDiff('Salário Inicial', concurso.salario_inicial, salario_inicial);
    getDiff('Taxa de Inscrição', concurso.taxa_inscricao, taxa_inscricao);
    getDiff('Escolaridade', concurso.escolaridade, escolaridade);
    getDiff('Formação', concurso.formacao, formacao);
    getDiff('Profissão', concurso.profissao, profissao);
    getDiff('Registro Profissional', concurso.registro_profissional, registro_profissional);
    getDiff('Idade Mínima', concurso.idade_minima, idade_minima);
    getDiff('Idade Máxima', concurso.idade_maxima, idade_maxima);
    
    const oldInicio = concurso.inscricao_inicio ? new Date(concurso.inscricao_inicio).toISOString().split('T')[0] : null;
    const newInicio = inscricao_inicio ? inscricao_inicio.toISOString().split('T')[0] : null;
    getDiff('Inscrições (Início)', oldInicio, newInicio);

    const oldFim = concurso.inscricao_fim ? new Date(concurso.inscricao_fim).toISOString().split('T')[0] : null;
    const newFim = inscricao_fim ? inscricao_fim.toISOString().split('T')[0] : null;
    getDiff('Inscrições (Fim)', oldFim, newFim);

    const oldProva = concurso.data_prova ? new Date(concurso.data_prova).toISOString().split('T')[0] : null;
    const newProva = data_prova ? data_prova.toISOString().split('T')[0] : null;
    getDiff('Data Prova', oldProva, newProva);

    getDiff('Link de Inscrição', concurso.link_inscricao, link_inscricao);
    getDiff('Resumo', concurso.resumo, resumo);

    const detalhes = changes.length > 0 ? changes.join('\n') : 'Nenhuma alteração de valor realizada.';

    await prisma.concurso.update({
      where: { id: concurso.id },
      data: {
        nome_concurso,
        estado,
        taxa_inscricao,
        salario_inicial,
        inscricao_inicio,
        inscricao_fim,
        data_prova,
        escolaridade,
        formacao,
        profissao,
        registro_profissional,
        idade_minima,
        idade_maxima,
        link_inscricao,
        resumo,
      }
    });

    // Registra na trilha de auditoria
    await createAuditLog(
      currentUser.id,
      currentUser.nome,
      'Editou Concurso',
      'Concurso',
      concurso.id,
      `Modificações na ficha de dados:\n${detalhes}`
    );

    return Astro.redirect(`/concursos/${concurso.id}?success=true`);
  } else if (action === 'update_cargo') {
    const cargoId = formData.get('cargo_id')?.toString();
    const nome_cargo = formData.get('nome_cargo')?.toString() || '';
    const escolaridade = formData.get('escolaridade')?.toString() || '';
    const salario = parseFloat(formData.get('salario')?.toString() || '0');
    const quantidade = parseInt(formData.get('quantidade')?.toString() || '0');
    const requisitos = formData.get('requisitos')?.toString() || '';

    const oldCargo = concurso.cargos.find(c => c.id === cargoId);
    if (oldCargo) {
      const changes: string[] = [];
      const getDiff = (field: string, oldVal: any, newVal: any) => {
        if (String(oldVal || '') !== String(newVal || '')) {
          changes.push(`• **${field}**: de "${oldVal || 'vazio'}" para "${newVal || 'vazio'}"`);
        }
      };

      getDiff('Nome do Cargo', oldCargo.nome_cargo, nome_cargo);
      getDiff('Escolaridade', oldCargo.escolaridade, escolaridade);
      getDiff('Salário', oldCargo.salario, salario);
      getDiff('Quantidade de Vagas', oldCargo.quantidade, quantidade);
      getDiff('Requisitos', oldCargo.requisitos, requisitos);

      const detalhes = changes.length > 0 ? changes.join('\n') : 'Nenhuma alteração de valor realizada.';

      await prisma.vaga.update({
        where: { id: cargoId },
        data: {
          nome_cargo,
          escolaridade,
          salario,
          quantidade,
          requisitos
        }
      });

      // Registra na trilha de auditoria
      await createAuditLog(
        currentUser.id,
        currentUser.nome,
        'Atualizou Cargo',
        'Concurso',
        concurso.id,
        `Atualizou informações do cargo "${nome_cargo}":\n${detalhes}`
      );
    }

    return Astro.redirect(`/concursos/${concurso.id}?success=true`);
  } else if (action === 'add_cargo') {
    const newCargo = await prisma.vaga.create({
      data: {
        concurso_id: concurso.id,
        nome_cargo: 'Novo Cargo',
        quantidade: 0,
        salario: 0
      }
    });

    // Registra na trilha de auditoria
    await createAuditLog(
      currentUser.id,
      currentUser.nome,
      'Adicionou Cargo',
      'Concurso',
      concurso.id,
      `Adicionou o cargo inicial "${newCargo.nome_cargo}" ao concurso`
    );

    return Astro.redirect(`/concursos/${concurso.id}?success=true`);
  } else if (action === 'delete_cargo') {
    const cargoId = formData.get('cargo_id')?.toString();
    const oldCargo = concurso.cargos.find(c => c.id === cargoId);
    const cargoNome = oldCargo ? oldCargo.nome_cargo : 'Desconhecido';

    await prisma.vaga.delete({ where: { id: cargoId } });

    // Registra na trilha de auditoria
    await createAuditLog(
      currentUser.id,
      currentUser.nome,
      'Excluiu Cargo',
      'Concurso',
      concurso.id,
      `Excluiu definitivamente o cargo "${cargoNome}" do concurso`
    );

    return Astro.redirect(`/concursos/${concurso.id}?success=true`);
  }
}

const success = Astro.url.searchParams.get('success') === 'true';

// Busca os logs de auditoria correspondentes a este concurso
const auditLogs = await prisma.logAuditoria.findMany({
  where: {
    entidade: 'Concurso',
    entidade_id: concurso.id
  },
  orderBy: {
    data_criacao: 'desc'
  }
});
---

<DashboardLayout title="Detalhes do Concurso">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a href="/editais" class="text-gray-500 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <div class="flex flex-col">
        <span class="px-2 py-0.5 w-fit bg-blue-500/10 text-blue-400 text-[9px] font-bold rounded uppercase mb-1 border border-blue-500/20">
          {concurso.edital.organizadora.nome}
        </span>
        <h2 class="text-lg font-outfit font-semibold text-gray-200">Gestão de Dados</h2>
      </div>
    </div>
    
    <div class="flex gap-2">
       {concurso.edital.nome_arquivo && (
        <a 
          href={`https://storageappvidanavida.blob.core.windows.net/editalhub/${concurso.edital.nome_arquivo}`} 
          target="_blank" 
          class="flex items-center gap-2 px-4 py-2 bg-red-500/10 text-red-400 text-xs font-bold rounded-xl hover:bg-red-500/20 transition-all border border-red-500/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14.5 2 14.5 7 20 7"/></svg>
          PDF Original
        </a>
      )}
    </div>
  </div>

  {success && (
    <div class="bg-green-500/10 border border-green-500/20 text-green-500 px-4 py-3 rounded-xl mb-8 text-sm flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      Dados salvos com sucesso!
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Informações Gerais -->
    <div class="lg:col-span-2 space-y-8">
      <div class="glass-card p-8">
        <h3 class="font-outfit font-semibold text-base mb-6 text-gray-400 uppercase tracking-widest flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Dados do Concurso
        </h3>
        
        <form method="POST">
          <input type="hidden" name="action" value="update_concurso" />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Dados Gerais -->
            <div class="md:col-span-2">
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Título / Órgão</label>
              <input name="nome_concurso" type="text" value={concurso.nome_concurso} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" required />
            </div>
            
            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Estado (UF)</label>
              <input name="estado" type="text" value={concurso.estado || ''} placeholder="Ex: SP, RJ, Nacional" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>
            
            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Salário Inicial (R$)</label>
              <input name="salario_inicial" type="number" step="0.01" value={concurso.salario_inicial?.toString() || ''} placeholder="Ex: 5500.00" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Taxa de Inscrição (R$)</label>
              <input name="taxa_inscricao" type="number" step="0.01" value={concurso.taxa_inscricao?.toString() || ''} placeholder="Ex: 120.00" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Escolaridade Predominante</label>
              <input name="escolaridade" type="text" value={concurso.escolaridade || ''} placeholder="Ex: Superior, Médio, Técnico" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <!-- Perfil & Requisitos -->
            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Formação Exigida</label>
              <input name="formacao" type="text" value={concurso.formacao || ''} placeholder="Ex: Direito, Engenharia Civil, Qualquer Área" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Profissão / Cargo Geral</label>
              <input name="profissao" type="text" value={concurso.profissao || ''} placeholder="Ex: Analista Judiciário, Guarda Municipal" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Registro Profissional Exigido</label>
              <input name="registro_profissional" type="text" value={concurso.registro_profissional || ''} placeholder="Ex: OAB, CREA, COREN" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Idade Mínima</label>
                <input name="idade_minima" type="number" value={concurso.idade_minima?.toString() || ''} placeholder="Ex: 18" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
              </div>
              <div>
                <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Idade Máxima</label>
                <input name="idade_maxima" type="number" value={concurso.idade_maxima?.toString() || ''} placeholder="Ex: 35" class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
              </div>
            </div>

            <!-- Datas & Links -->
            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Inscrições (Início)</label>
              <input name="inscricao_inicio" type="date" value={concurso.inscricao_inicio ? concurso.inscricao_inicio.toISOString().split('T')[0] : ''} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Inscrições (Fim)</label>
              <input name="inscricao_fim" type="date" value={concurso.inscricao_fim ? concurso.inscricao_fim.toISOString().split('T')[0] : ''} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Data da Prova</label>
              <input name="data_prova" type="date" value={concurso.data_prova ? concurso.data_prova.toISOString().split('T')[0] : ''} class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <div>
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Link de Inscrição Oficial</label>
              <input name="link_inscricao" type="url" value={concurso.link_inscricao || ''} placeholder="https://..." class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none" />
            </div>

            <!-- Resumo IA -->
            <div class="md:col-span-2">
              <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-2 font-bold">Resumo do Concurso (IA)</label>
              <textarea name="resumo" rows="6" placeholder="Escreva uma breve descrição textual sobre o concurso (requisitos, taxas, prazos, etc)..." class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-blue-500 outline-none resize-y">{concurso.resumo || ''}</textarea>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/5 flex justify-end">
            <button type="submit" class="btn-primary">Salvar Dados Gerais</button>
          </div>
        </form>
      </div>

      <!-- Tabela de Cargos -->
      <div class="glass-card overflow-hidden">
        <div class="px-8 py-6 border-b border-white/5 bg-white/[0.01] flex justify-between items-center">
          <h3 class="font-outfit font-semibold text-gray-400 text-sm uppercase tracking-widest">Cargos e Vagas</h3>
          <form method="POST">
            <input type="hidden" name="action" value="add_cargo" />
            <button type="submit" class="text-xs font-bold text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
              Adicionar Cargo
            </button>
          </form>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="text-[10px] text-gray-500 uppercase tracking-widest bg-white/[0.02]">
                <th class="px-8 py-4 font-medium">Nome do Cargo</th>
                <th class="px-8 py-4 font-medium">Escolaridade</th>
                <th class="px-8 py-4 font-medium w-32">Salário</th>
                <th class="px-8 py-4 font-medium w-24">Vagas</th>
                <th class="px-8 py-4 font-medium text-right">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {concurso.cargos.length === 0 && (
                <tr>
                  <td colspan="5" class="px-8 py-12 text-center text-xs text-gray-500 italic">
                    Nenhum cargo cadastrado. Clique em "Adicionar Cargo" para começar.
                  </td>
                </tr>
              )}
              {concurso.cargos.map(cargo => (
                <tr class="hover:bg-white/[0.01] group">
                  <form method="POST" class="contents">
                    <input type="hidden" name="action" value="update_cargo" />
                    <input type="hidden" name="cargo_id" value={cargo.id} />
                    
                    <td class="px-8 py-4">
                      <input name="nome_cargo" type="text" value={cargo.nome_cargo} class="bg-transparent border-none text-sm font-semibold w-full focus:ring-1 focus:ring-blue-500 rounded px-1 text-gray-200" />
                    </td>
                    <td class="px-8 py-4">
                      <input name="escolaridade" type="text" value={cargo.escolaridade} placeholder="Nível..." class="bg-transparent border-none text-xs text-gray-400 w-full focus:ring-1 focus:ring-blue-500 rounded px-1" />
                    </td>
                    <td class="px-8 py-4">
                      <input name="salario" type="number" step="0.01" value={cargo.salario?.toString()} class="bg-transparent border-none text-sm text-blue-400 w-full focus:ring-1 focus:ring-blue-500 rounded px-1 font-mono" />
                    </td>
                    <td class="px-8 py-4">
                      <input name="quantidade" type="number" value={cargo.quantidade} class="bg-transparent border-none text-sm text-gray-300 w-full focus:ring-1 focus:ring-blue-500 rounded px-1" />
                    </td>
                    <td class="px-8 py-4 text-right">
                      <div class="flex justify-end gap-2">
                        <button type="submit" class="p-2 text-blue-400 hover:bg-blue-400/10 rounded-lg transition-all" title="Atualizar Cargo">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        </button>
                        <button 
                          type="submit" 
                          name="action" 
                          value="delete_cargo" 
                          class="p-2 text-red-400 hover:bg-red-400/10 rounded-lg transition-all"
                          onclick="return confirm('Excluir este cargo?')"
                        >
                           <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                        </button>
                      </div>
                    </td>
                  </form>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Sidebar de Contexto -->
    <div class="space-y-6">
      <div class="glass-card p-6 bg-gradient-to-br from-blue-500/5 to-indigo-500/5">
        <h4 class="text-sm font-semibold mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Modo Manual
        </h4>
        <p class="text-xs text-gray-400 leading-relaxed italic">
          Utilize esta tela para preencher os dados caso a IA não tenha extraído corretamente ou para inclusões manuais de editais antigos.
        </p>
      </div>

      <div class="glass-card p-6">
        <h4 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Informações do Edital</h4>
        <div class="space-y-4">
          <div>
            <span class="text-[10px] text-gray-500 uppercase block mb-1">Nome no Portal</span>
            <p class="text-xs text-gray-300 font-medium">{concurso.edital.nome_edital}</p>
          </div>
          <div>
            <span class="text-[10px] text-gray-500 uppercase block mb-1">Status de Coleta</span>
            <span class="px-2 py-0.5 bg-green-500/10 text-green-400 text-[9px] font-bold rounded uppercase">Válido</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Histórico de Auditoria e Alterações -->
  <div class="glass-card p-8 mt-8 border-white/5 bg-[#0f0f11]/30">
    <h3 class="font-outfit font-semibold text-xs mb-6 text-gray-400 uppercase tracking-widest flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      Histórico de Auditoria do Concurso
    </h3>
    
    {auditLogs.length === 0 ? (
      <div class="p-6 text-center text-xs text-gray-500 italic bg-white/[0.01] rounded-xl border border-white/5">
        Nenhum registro de auditoria disponível para este concurso.
      </div>
    ) : (
      <div class="relative pl-6 border-l border-white/5 space-y-6">
        {auditLogs.map(log => (
          <div class="relative group/timeline">
            <!-- Ponto na linha do tempo -->
            <div class="absolute -left-[32px] top-1.5 w-3.5 h-3.5 rounded-full bg-[#0a0a0b] border-2 border-indigo-500/50 flex items-center justify-center group-hover/timeline:border-indigo-400 transition-colors">
              <div class="w-1.5 h-1.5 rounded-full bg-indigo-400"></div>
            </div>
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-semibold text-gray-200">{log.usuario_nome}</span>
                <span class={`text-[8px] font-bold px-1.5 py-0.5 rounded border uppercase tracking-wider ${
                  log.acao === 'Criou Concurso'
                    ? 'bg-green-500/10 text-green-400 border-green-500/20'
                    : log.acao === 'Excluiu Cargo'
                      ? 'bg-red-500/10 text-red-400 border-red-500/20'
                      : 'bg-blue-500/10 text-blue-400 border-blue-500/20'
                }`}>
                  {log.acao}
                </span>
              </div>
              <span class="text-[10px] text-gray-500 font-mono">
                {new Date(log.data_criacao).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'medium' })}
              </span>
            </div>

            {log.detalhes && (
              <div class="bg-white/[0.015] border border-white/5 rounded-xl p-3.5 mt-2 text-xs text-gray-400 leading-relaxed font-mono whitespace-pre-line border-l-2 border-l-indigo-500/30">
                {log.detalhes}
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</DashboardLayout>
