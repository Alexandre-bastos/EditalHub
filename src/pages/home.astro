import prisma from '../lib/prisma';
import '../styles/global.css';

const hoje = new Date();
let dbConcursos: any[] = [];
let dbError = null;

try {
  dbConcursos = await prisma.concurso.findMany({
    include: {
      edital: {
        include: {
          organizadora: true
        }
      },
      cargos: true
    }
  });
} catch (e: any) {
  console.error("Erro ao buscar concursos para landing page:", e.message);
  dbError = e.message;
}

// Filtra vigentes de verdade
const concursosVigentes = dbConcursos.filter(c => {
  if (!c.inscricao_fim) return true; // se não tiver data final, mostra
  const fim = new Date(c.inscricao_fim);
  fim.setHours(23, 59, 59, 999);
  return fim >= hoje;
});

