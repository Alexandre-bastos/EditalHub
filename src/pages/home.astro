    <!-- Script Client-Side para Interação Premium Rápida -->
    <script define:vars={{ listagemFinal }}>
      // 1. Dados
      const contests = listagemFinal;

      // 2. Elementos
      const schoolFilters = document.getElementById('school-filters');
      const resultsSection = document.getElementById('results-section');
      const currentLevelTag = document.getElementById('current-level-tag');
      const statEncontrados = document.getElementById('stat-encontrados');
      const statSalario = document.getElementById('stat-salario');
      const statAbertas = document.getElementById('stat-abertas');
      const statPrevistos = document.getElementById('stat-previstos');
      const cardsContainer = document.getElementById('contest-cards-container');

      const conversionModal = document.getElementById('conversion-modal');
      const closeConversionBtn = document.getElementById('close-conversion-btn');

      // 3. Ações ao clicar em escolaridade
      schoolFilters?.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;

        const level = btn.dataset.level;

        // Estiliza o botão selecionado
        schoolFilters.querySelectorAll('button').forEach(b => {
          b.className = "px-4 py-3 rounded-xl bg-white hover:bg-indigo-50 hover:border-indigo-300 hover:text-indigo-700 border border-slate-200 text-xs font-semibold text-slate-600 transition-all cursor-pointer shadow-[0_1px_2px_rgba(0,0,0,0.03)] active:scale-95";
        });
        btn.className = "px-4 py-3 rounded-xl bg-indigo-50 text-indigo-700 border border-indigo-300 text-xs font-bold transition-all shadow-[0_4px_12px_rgba(99,102,241,0.08)] active:scale-95";

        // Filtra concursos correspondentes
        const filtered = contests.filter(c => c.escolaridade.toLowerCase() === level.toLowerCase());

        // Revela com suavidade
        resultsSection.classList.remove('hidden');
        setTimeout(() => {
          resultsSection.scrollIntoView({ behavior: 'smooth' });
        }, 150);

        // Atualiza estatísticas com efeito de contagem rápida
        currentLevelTag.innerText = level;
        statEncontrados.innerText = filtered.length;
        
        const salarios = filtered.map(c => c.salario_inicial);
        const maxSal = salarios.length > 0 ? Math.max(...salarios) : 0;
        statSalario.innerText = maxSal > 0 ? `R$ ${maxSal.toLocaleString('pt-BR', { maximumFractionDigits: 0 })}` : 'R$ 0';
        
        statAbertas.innerText = filtered.filter(c => c.inscricao_fim).length;
        statPrevistos.innerText = Math.floor(filtered.length * 0.25) + 1;

        // Injeta os cards de forma ultra-elegante
        cardsContainer.innerHTML = '';
        if (filtered.length === 0) {
          cardsContainer.innerHTML = `
            <div class="col-span-1 md:col-span-3 text-center py-12 bg-slate-50 border border-slate-100 rounded-2xl p-6">
              <p class="text-xs text-slate-400">Nenhum concurso ativo processado para essa escolaridade no momento. Utilize o simulador avançado abaixo.</p>
            </div>
          `;
          return;
        }

        // Exibe top 3
        filtered.slice(0, 3).forEach(c => {
          const card = document.createElement('div');
          card.className = "bg-white border border-slate-200/80 p-6 rounded-2xl flex flex-col justify-between gap-6 relative overflow-hidden group hover:border-indigo-400 hover:shadow-xl transition-all duration-300 cursor-pointer text-left shadow-sm";
          
          card.innerHTML = `
            <div class="space-y-4">
              <div class="flex justify-between items-center gap-3">
                <span class="px-2.5 py-0.5 bg-indigo-50 border border-indigo-100 text-indigo-600 text-[8px] font-bold rounded uppercase tracking-wider font-mono">
                  ${c.edital.organizadora.nome}
                </span>
                <span class="text-[9px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-full flex items-center gap-1 select-none font-mono">
                  ✦ Match ${c.compatibilidade}%
                </span>
              </div>

              <div class="space-y-1">
                <h4 class="text-sm font-outfit font-extrabold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">${c.nome_concurso}</h4>
                <p class="text-[10px] text-slate-400 font-semibold">Estado: <span class="text-slate-600 font-bold">${c.estado}</span> | Área: <span class="text-slate-600 font-bold">${c.area}</span></p>
              </div>

              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed font-light">${c.resumo}</p>
            </div>

            <div class="flex justify-between items-center border-t border-slate-100 pt-4">
              <div class="flex flex-col">
                <span class="text-slate-400 text-[8px] uppercase tracking-widest font-bold">Salário Inicial</span>
                <span class="text-sm font-extrabold text-slate-800 font-mono">R$ ${c.salario_inicial.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
              </div>
              <button class="px-3.5 py-2 bg-slate-50 group-hover:bg-slate-900 group-hover:text-white rounded-lg text-[9px] font-bold transition-all duration-300 flex items-center gap-1 trigger-conversion cursor-pointer uppercase tracking-wider border border-slate-200 group-hover:border-transparent">
                Detalhes
                <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </div>
          `;
          cardsContainer.appendChild(card);
        });

        // Adiciona ouvintes para disparo do modal
        cardsContainer.querySelectorAll('.trigger-conversion, .bg-white').forEach(el => {
          el.addEventListener('click', (ev) => {
            ev.stopPropagation();
            openConversionModal();
          });
        });
      });

      // 4. Modal de Conversão
      function openConversionModal() {
        if (!conversionModal) return;
        conversionModal.classList.remove('opacity-0', 'pointer-events-none');
        const content = conversionModal.querySelector('div');
        if (content) {
          content.classList.remove('scale-95');
          content.classList.add('scale-100');
        }
      }

      function closeConversionModal() {
        if (!conversionModal) return;
        const content = conversionModal.querySelector('div');
        if (content) {
          content.classList.remove('scale-100');
          content.classList.add('scale-95');
        }
        conversionModal.classList.add('opacity-0', 'pointer-events-none');
      }

      closeConversionBtn?.addEventListener('click', closeConversionModal);
      conversionModal?.addEventListener('click', (e) => {
        if (e.target === conversionModal) closeConversionModal();
      });

      document.querySelectorAll('.trigger-global-conversion').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openConversionModal();
        });
      });

      // 5. Simulador
      const runSimBtn = document.getElementById('run-simulation-btn');
      const simSpinner = document.getElementById('sim-spinner');
      const simSchool = document.getElementById('sim-school');
      const simState = document.getElementById('sim-state');
      const simArea = document.getElementById('sim-area');
      const simResult = document.getElementById('simulation-result');
      const simResCount = document.getElementById('sim-res-count');
      const simResSalary = document.getElementById('sim-res-salary');
      const simResHighlight = document.getElementById('sim-res-highlight');

      runSimBtn?.addEventListener('click', () => {
        if (simSpinner) simSpinner.classList.remove('hidden');
        runSimBtn.disabled = true;

        setTimeout(() => {
          if (simSpinner) simSpinner.classList.add('hidden');
          runSimBtn.disabled = false;

          const schoolVal = simSchool.value;
          const stateVal = simState.value;
          const areaVal = simArea.value;

          let filtered = contests;
          
          if (schoolVal) {
            filtered = filtered.filter(c => c.escolaridade.toLowerCase() === schoolVal.toLowerCase());
          }
          if (stateVal && stateVal !== 'Todos') {
            filtered = filtered.filter(c => c.estado.toLowerCase().includes(stateVal.toLowerCase()));
          }
          if (areaVal && areaVal !== 'Todas') {
            filtered = filtered.filter(c => c.area.toLowerCase().includes(areaVal.toLowerCase()) || c.resumo.toLowerCase().includes(areaVal.toLowerCase()));
          }

          const count = filtered.length;
          const salaries = filtered.map(c => c.salario_inicial);
          const avgSalary = salaries.length > 0 ? (salaries.reduce((a, b) => a + b, 0) / salaries.length) : 0;

          if (simResult) {
            simResult.classList.remove('hidden');
            if (simResCount) simResCount.innerText = count;
            if (simResSalary) simResSalary.innerText = avgSalary > 0 ? `R$ ${avgSalary.toLocaleString('pt-BR', { maximumFractionDigits: 0 })}` : 'R$ 0';
            if (simResHighlight) simResHighlight.innerText = areaVal !== 'Todas' ? areaVal : 'Geral';
            
            simResult.scrollIntoView({ behavior: 'smooth' });
          }
        }, 800);
      });

      // 6. Mapa Interativo (Fase 15)
      const mapContestData = {
        sp: {
          orgao: "Tribunal de Justiça de SP",
          banca: "Vunesp",
          salario: "R$ 7.200,00",
          vagas: "150 vagas",
          status: "Inscrições Abertas",
          classeStatus: "bg-emerald-50 text-emerald-600 border-emerald-100"
        },
        rj: {
          orgao: "Polícia Civil do Estado do RJ",
          banca: "FGV",
          salario: "R$ 6.200,00",
          vagas: "120 vagas",
          status: "Inscrições Abertas",
          classeStatus: "bg-emerald-50 text-emerald-600 border-emerald-100"
        },
        df: {
          orgao: "Tribunal de Contas da União",
          banca: "FGV",
          salario: "R$ 26.800,00",
          vagas: "20 vagas",
          status: "Inscrições Abertas",
          classeStatus: "bg-emerald-50 text-emerald-600 border-emerald-100"
        },
        mg: {
          orgao: "Prefeitura de Belo Horizonte",
          banca: "IBGP",
          salario: "R$ 4.800,00",
          vagas: "300 vagas",
          status: "Inscrições Abertas",
          classeStatus: "bg-emerald-50 text-emerald-600 border-emerald-100"
        },
        sc: {
          orgao: "Tribunal de Justiça de SC",
          banca: "FGV",
          salario: "R$ 8.500,00",
          vagas: "45 vagas",
          status: "Inscrições Abertas",
          classeStatus: "bg-emerald-50 text-emerald-600 border-emerald-100"
        },
        ba: {
          orgao: "Banco do Brasil S.A. (BA)",
          banca: "Cesgranrio",
          salario: "R$ 5.900,00",
          vagas: "80 vagas",
          status: "Inscrições Abertas",
          classeStatus: "bg-emerald-50 text-emerald-600 border-emerald-100"
        }
      };

      const mapPins = document.querySelectorAll('.map-pin-node');
      const mapTooltip = document.getElementById('map-dynamic-tooltip');
      const teaserSvgMap = document.getElementById('teaser-svg-map');

      mapPins.forEach(pin => {
        pin.addEventListener('mouseenter', (e) => {
          const contestKey = pin.getAttribute('data-contest');
          const data = mapContestData[contestKey];
          if (!data) return;

          mapTooltip.innerHTML = `
            <div class="space-y-3.5">
              <div class="flex justify-between items-center gap-2">
                <span class="px-2 py-0.5 bg-indigo-50 border border-indigo-100 text-indigo-600 text-[8.5px] font-bold rounded uppercase tracking-wider font-mono">
                  ` + data.banca + `
                </span>
                <span class="px-2 py-0.5 ` + data.classeStatus + ` border text-[8.5px] font-bold rounded uppercase tracking-wider font-mono">
                  ` + data.status + `
                </span>
              </div>
              <div class="space-y-0.5">
                <h4 class="text-xs font-outfit font-extrabold text-slate-800 line-clamp-1 leading-tight">` + data.orgao + `</h4>
                <p class="text-[9px] text-slate-400 font-semibold font-mono">Vagas: <span class="text-slate-600 font-bold">` + data.vagas + `</span></p>
              </div>
              <div class="flex justify-between items-center border-t border-slate-100 pt-2.5">
                <div class="flex flex-col">
                  <span class="text-slate-400 text-[8px] uppercase tracking-widest font-bold">Salário</span>
                  <span class="text-xs font-extrabold text-slate-800 font-mono">` + data.salario + `</span>
                </div>
                <div class="text-right">
                  <span class="inline-flex items-center gap-0.5 text-[8.5px] font-extrabold text-indigo-600 bg-indigo-50 border border-indigo-100/50 px-1.5 py-0.5 rounded-full select-none">
                    🔒 Proximidade & Rotas
                  </span>
                </div>
              </div>
            </div>
          `;

          const parentRect = teaserSvgMap.parentElement.getBoundingClientRect();
          const pinRect = pin.getBoundingClientRect();
          
          const left = pinRect.left - parentRect.left + (pinRect.width / 2) - (mapTooltip.offsetWidth / 2);
          const top = pinRect.top - parentRect.top - mapTooltip.offsetHeight - 12;

          mapTooltip.style.left = left + 'px';
          mapTooltip.style.top = top + 'px';

          mapTooltip.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
          mapTooltip.classList.add('opacity-100', 'scale-100');
        });

        pin.addEventListener('mouseleave', () => {
          mapTooltip.classList.remove('opacity-100', 'scale-100');
          mapTooltip.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        });

        pin.addEventListener('click', (e) => {
          e.preventDefault();
          openConversionModal();
        });
      });

      if (mapTooltip) {
        mapTooltip.addEventListener('click', (e) => {
          openConversionModal();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .font-outfit { font-family: 'Outfit', sans-serif; }
  .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }
  
  @keyframes scan {
    0% { top: 0%; }
    50% { top: 75%; }
    100% { top: 0%; }
  }
  .animate-scan {
    animation: scan 4s linear infinite;
  }

  @keyframes slowGlow {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; transform: scale(1.05); }
  }
  .animate-slow-glow {
    animation: slowGlow 10s ease-in-out infinite;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
