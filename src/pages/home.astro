const user = Astro.locals.user;
---

<!doctype html>
<html lang="pt-br" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Existe um concurso ideal para você. Descubra agora com a inteligência artificial do EditalHub." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>EditalHub | Descubra Seu Concurso Ideal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#030303] text-[#f4f4f6] font-jakarta min-h-screen relative overflow-x-hidden selection:bg-indigo-500/30 selection:text-indigo-200 antialiased">
    
    <!-- Ultra-Premium Glowing System (Glows em 3D de alta sofisticação) -->
    <div class="absolute top-[-25%] left-[-15%] w-[80%] h-[80%] rounded-full bg-[radial-gradient(circle,rgba(99,102,241,0.15)_0%,rgba(0,0,0,0)_70%)] blur-[160px] -z-10 animate-slow-glow"></div>
    <div class="absolute top-[20%] right-[-25%] w-[70%] h-[70%] rounded-full bg-[radial-gradient(circle,rgba(59,130,246,0.12)_0%,rgba(0,0,0,0)_70%)] blur-[180px] -z-10"></div>
    <div class="absolute bottom-[-10%] left-[-15%] w-[60%] h-[60%] rounded-full bg-[radial-gradient(circle,rgba(168,85,247,0.08)_0%,rgba(0,0,0,0)_70%)] blur-[140px] -z-10"></div>

    <!-- Floating Elegant Header -->
    <header class="w-full border-b border-white/5 bg-[#030303]/75 backdrop-blur-xl sticky top-0 z-40 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-8 py-5 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <!-- Logo com Glow -->
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-lg blur opacity-30 group-hover:opacity-75 transition duration-500"></div>
            <div class="relative bg-black px-3 py-1.5 rounded-lg border border-white/10 flex items-center gap-2">
              <span class="text-xl font-outfit font-extrabold bg-gradient-to-r from-white via-slate-100 to-indigo-300 bg-clip-text text-transparent tracking-tight">
                Edital<span class="text-indigo-400">Hub</span>
              </span>
            </div>
          </div>
          <span class="px-2 py-0.5 bg-gradient-to-r from-indigo-500/10 to-blue-500/10 text-indigo-300 text-[9px] font-bold rounded border border-indigo-500/20 uppercase tracking-widest font-mono">AI Engine</span>
        </div>
        
        <nav class="flex items-center gap-8">
          <a href="#simulator" class="text-xs font-semibold text-gray-400 hover:text-white transition-colors relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[2px] after:bg-indigo-400 hover:after:w-full after:transition-all after:duration-300">Simulador</a>
          <a href="#how-it-works" class="text-xs font-semibold text-gray-400 hover:text-white transition-colors relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[2px] after:bg-indigo-400 hover:after:w-full after:transition-all after:duration-300">Como Funciona</a>
          <a href="#salaries" class="text-xs font-semibold text-gray-400 hover:text-white transition-colors relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[2px] after:bg-indigo-400 hover:after:w-full after:transition-all after:duration-300">Salários</a>
          
          {user ? (
            <a 
              href="/dashboard" 
              class="text-xs bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white px-5 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-indigo-900/40 flex items-center gap-2 active:scale-95 border border-indigo-500/30"
            >
              Acessar Painel
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            </a>
          ) : (
            <div class="flex items-center gap-5">
              <a href="/login" class="text-xs font-bold text-gray-300 hover:text-white transition-colors">Entrar</a>
              <a 
                href="/cadastro" 
                class="text-xs bg-white text-black hover:bg-slate-100 px-5 py-2.5 rounded-xl font-extrabold transition-all shadow-xl shadow-white/5 active:scale-95 border border-white/10"
              >
                Criar Conta Grátis
              </a>
            </div>
          )}
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-8 py-16 space-y-36">
      
      <!-- 1. HERO INTELIGENTE E VISUAL CENTERPIECE -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center py-6">
        
        <!-- Textos e Headline do Hero -->
        <div class="lg:col-span-6 space-y-8 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gradient-to-r from-indigo-500/10 to-blue-500/10 border border-indigo-500/20 text-[10px] font-bold text-indigo-300 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-ping"></span>
            Revolução no Mapeamento de Editais
          </div>
          
          <h1 class="text-5xl md:text-6xl font-outfit font-extrabold text-white tracking-tight leading-[1.05]">
            Existe um concurso <span class="bg-gradient-to-r from-indigo-200 via-indigo-400 to-indigo-500 bg-clip-text text-transparent">perfeito</span> para você.
          </h1>
          
          <p class="text-base text-gray-400 leading-relaxed max-w-xl font-light">
            Desenvolvemos uma inteligência que varre diários oficiais do Brasil inteiro, cruza requisitos técnicos de editais complexos e revela instantaneamente as carreiras onde suas chances de aprovação são máximas.
          </p>

          <!-- Escolaridade Rápida Integrada no Hero -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500">Comece experimentando em 1 clique:</h4>
            
            <div class="flex flex-wrap gap-2.5" id="school-filters">
              {["Ensino Fundamental", "Ensino Médio", "Técnico", "Superior", "Pós-graduação"].map((level) => (
                <button 
                  data-level={level} 
                  class="px-4 py-3 rounded-xl bg-white/[0.02] hover:bg-indigo-600/10 hover:border-indigo-500/40 hover:text-indigo-200 border border-white/5 text-xs font-semibold text-gray-400 transition-all cursor-pointer hover:shadow-[0_0_15px_rgba(99,102,241,0.1)] active:scale-95"
                >
                  {level === "Técnico" ? "Ensino Técnico" : level === "Superior" ? "Ensino Superior" : level}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Visual Centerpiece: UI Mockup / AI Scanning Radar Simulator -->
        <div class="lg:col-span-6 flex justify-center relative">
          <!-- Brilho Atrás do Mockup -->
          <div class="absolute -inset-4 bg-gradient-to-tr from-indigo-600 to-blue-500 rounded-3xl opacity-10 blur-xl"></div>
          
          <!-- Mockup Frame -->
          <div class="relative w-full max-w-lg bg-[#0a0a0d] border border-white/10 rounded-2xl p-6 shadow-[0_20px_50px_rgba(0,0,0,0.8)] overflow-hidden group">
            
            <!-- Linhas de Design High-Tech -->
            <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>
            
            <!-- Header do Mockup -->
            <div class="flex justify-between items-center border-b border-white/5 pb-4 mb-4">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/40"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/40"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/40"></span>
              </div>
              <span class="text-[9px] font-mono text-indigo-400/60 uppercase tracking-widest">AI Radar Scanner</span>
            </div>

            <!-- Scanner Simulator Interface -->
            <div class="space-y-4">
              <!-- Search simulation box -->
              <div class="bg-white/[0.02] border border-white/5 rounded-xl p-3.5 flex justify-between items-center">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  </div>
                  <div class="text-left">
                    <p class="text-[10px] text-gray-500 font-semibold uppercase tracking-wider">Perfil analisado</p>
                    <p class="text-xs font-bold text-white">Candidato de Alto Desempenho</p>
                  </div>
                </div>
                <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[8px] font-bold rounded uppercase">Ativo</span>
              </div>

              <!-- Animated Scan list -->
              <div class="space-y-2.5 relative">
                <!-- Overlay scan line effect -->
                <div class="absolute left-0 w-full h-[60px] bg-gradient-to-b from-indigo-500/0 via-indigo-500/10 to-indigo-500/0 border-y border-indigo-500/20 opacity-80 animate-scan pointer-events-none"></div>
                
                <!-- Mock Contest item 1 -->
                <div class="bg-white/[0.01] border border-white/5 rounded-xl p-3 flex justify-between items-center transition-all duration-500 hover:bg-white/[0.03]">
                  <div class="text-left space-y-1">
                    <span class="px-1.5 py-0.2 bg-blue-500/10 border border-blue-500/20 text-blue-300 text-[7px] font-bold rounded font-mono uppercase">VUNESP</span>
                    <h5 class="text-xs font-bold text-white">Tribunal de Justiça SP</h5>
                    <p class="text-[9px] text-gray-500">Cargo: Escrevente Técnico</p>
                  </div>
                  <div class="text-right space-y-1">
                    <span class="text-xs font-extrabold text-emerald-400">96% compatível</span>
                    <p class="text-[9px] text-indigo-300 font-bold">R$ 7.200,00</p>
                  </div>
                </div>

                <!-- Mock Contest item 2 -->
                <div class="bg-white/[0.01] border border-white/5 rounded-xl p-3 flex justify-between items-center opacity-60">
                  <div class="text-left space-y-1">
                    <span class="px-1.5 py-0.2 bg-purple-500/10 border border-purple-500/20 text-purple-300 text-[7px] font-bold rounded font-mono uppercase">FGV</span>
                    <h5 class="text-xs font-bold text-white">Senado Federal</h5>
                    <p class="text-[9px] text-gray-500">Cargo: Analista Legislativo</p>
