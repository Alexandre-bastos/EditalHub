// Mescla concursos
const listagemFinal = [...concursosVigentes.map(c => ({
  id: c.id,
  nome_concurso: c.nome_concurso,
  estado: c.estado || "N/A",
  escolaridade: c.escolaridade || "Superior",
  salario_inicial: c.salario_inicial ? Number(c.salario_inicial) : 0,
  taxa_inscricao: c.taxa_inscricao ? Number(c.taxa_inscricao) : 0,
  inscricao_inicio: c.inscricao_inicio ? new Date(c.inscricao_inicio).toISOString().split('T')[0] : '',
  inscricao_fim: c.inscricao_fim ? new Date(c.inscricao_fim).toISOString().split('T')[0] : '',
  data_prova: c.data_prova ? new Date(c.data_prova).toISOString().split('T')[0] : '',
