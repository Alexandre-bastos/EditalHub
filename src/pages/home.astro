})), ...mockConcursos];

const user = Astro.locals.user;
---

<!doctype html>
<html lang="pt-br" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Existe um concurso ideal para você. Descubra agora com a inteligência artificial do EditalHub." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>EditalHub | Descubra Seu Concurso Ideal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#fafafc] text-slate-800 font-jakarta min-h-screen relative overflow-x-hidden selection:bg-indigo-500/20 selection:text-indigo-900 antialiased">
    
    <!-- Clean Premium Decorative Light Glows (Glows em tons claros com opacidade reduzida para sofisticação) -->
    <div class="absolute top-[-25%] left-[-15%] w-[80%] h-[80%] rounded-full bg-[radial-gradient(circle,rgba(99,102,241,0.06)_0%,rgba(0,0,0,0)_70%)] blur-[160px] -z-10 animate-slow-glow"></div>
    <div class="absolute top-[20%] right-[-25%] w-[70%] h-[70%] rounded-full bg-[radial-gradient(circle,rgba(59,130,246,0.05)_0%,rgba(0,0,0,0)_70%)] blur-[180px] -z-10"></div>
    <div class="absolute bottom-[-10%] left-[-15%] w-[60%] h-[60%] rounded-full bg-[radial-gradient(circle,rgba(168,85,247,0.04)_0%,rgba(0,0,0,0)_70%)] blur-[140px] -z-10"></div>

    <!-- Floating Elegant Header in White -->
    <header class="w-full border-b border-slate-200/50 bg-white/80 backdrop-blur-xl sticky top-0 z-40 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-8 py-4.5 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <!-- Logo com Glow Suave -->
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-blue-400 rounded-lg blur opacity-15 group-hover:opacity-40 transition duration-500"></div>
            <div class="relative bg-white px-3.5 py-1.5 rounded-lg border border-slate-200 flex items-center gap-2 shadow-sm">
              <span class="text-xl font-outfit font-extrabold bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 bg-clip-text text-transparent tracking-tight">
                Edital<span class="text-indigo-600">Hub</span>
              </span>
            </div>
          </div>
          <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[9px] font-bold rounded border border-indigo-100 uppercase tracking-widest font-mono">AI Engine</span>
        </div>
        
        <nav class="flex items-center gap-8">
          <a href="#simulator" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[2px] after:bg-indigo-600 hover:after:w-full after:transition-all after:duration-300">Simulador</a>
          <a href="#how-it-works" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[2px] after:bg-indigo-600 hover:after:w-full after:transition-all after:duration-300">Como Funciona</a>
          <a href="#salaries" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[2px] after:bg-indigo-600 hover:after:w-full after:transition-all after:duration-300">Salários</a>
          
          {user ? (
            <a 
              href="/dashboard" 
              class="text-xs bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2.5 rounded-xl font-bold transition-all shadow-md shadow-indigo-200 flex items-center gap-2 active:scale-95 border border-indigo-700/10"
            >
              Acessar Painel
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            </a>
          ) : (
            <div class="flex items-center gap-5">
              <a href="/login" class="text-xs font-bold text-slate-600 hover:text-slate-900 transition-colors">Entrar</a>
              <a 
                href="/cadastro" 
                class="text-xs bg-slate-900 text-white hover:bg-slate-800 px-5 py-2.5 rounded-xl font-extrabold transition-all shadow-md active:scale-95 border border-slate-950"
              >
                Criar Conta Grátis
              </a>
            </div>
          )}
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-8 py-16 space-y-36">
      
      <!-- 1. HERO INTELIGENTE E VISUAL CENTERPIECE (WHITE THEME) -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center py-6">
        
        <!-- Textos e Headline do Hero -->
        <div class="lg:col-span-6 space-y-8 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-[10px] font-bold text-indigo-600 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-ping"></span>
            Revolução no Mapeamento de Editais
          </div>
          
          <h1 class="text-5xl md:text-6xl font-outfit font-extrabold text-slate-900 tracking-tight leading-[1.05]">
            Existe um concurso <span class="bg-gradient-to-r from-indigo-600 to-blue-600 bg-clip-text text-transparent">perfeito</span> para você.
          </h1>
          
          <p class="text-base text-slate-500 leading-relaxed max-w-xl font-light">
            Desenvolvemos uma inteligência que varre diários oficiais do Brasil inteiro, cruza requisitos técnicos de editais complexos e revela instantaneamente as carreiras onde suas chances de aprovação são máximas.
          </p>

          <!-- Escolaridade Rápida Integrada no Hero -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Comece experimentando em 1 clique:</h4>
            
            <div class="flex flex-wrap gap-2.5" id="school-filters">
              {["Ensino Fundamental", "Ensino Médio", "Técnico", "Superior", "Pós-graduação"].map((level) => (
                <button 
                  data-level={level} 
                  class="px-4 py-3 rounded-xl bg-white hover:bg-indigo-50 hover:border-indigo-300 hover:text-indigo-700 border border-slate-200 text-xs font-semibold text-slate-600 transition-all cursor-pointer shadow-[0_1px_2px_rgba(0,0,0,0.03)] active:scale-95"
                >
                  {level === "Técnico" ? "Ensino Técnico" : level === "Superior" ? "Ensino Superior" : level}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Visual Centerpiece: UI Mockup / AI Scanning Radar Simulator (White/Light Theme) -->
        <div class="lg:col-span-6 flex justify-center relative">
          <!-- Brilho Atrás do Mockup -->
          <div class="absolute -inset-4 bg-gradient-to-tr from-indigo-500 to-blue-400 rounded-3xl opacity-5 blur-xl"></div>
          
          <!-- Mockup Frame -->
          <div class="relative w-full max-w-lg bg-white border border-slate-200/80 rounded-2xl p-6 shadow-[0_20px_40px_rgba(15,23,42,0.08)] overflow-hidden group">
            
            <!-- Linhas de Design High-Tech -->
            <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-indigo-500/30 to-transparent"></div>
            
            <!-- Header do Mockup -->
            <div class="flex justify-between items-center border-b border-slate-100 pb-4 mb-4">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-400/60"></span>
              </div>
              <span class="text-[9px] font-mono text-slate-400 uppercase tracking-widest">AI Radar Scanner</span>
            </div>

            <!-- Scanner Simulator Interface -->
            <div class="space-y-4">
              <!-- Search simulation box -->
              <div class="bg-slate-50 border border-slate-100 rounded-xl p-3.5 flex justify-between items-center">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  </div>
                  <div class="text-left">
                    <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Perfil analisado</p>
                    <p class="text-xs font-bold text-slate-800">Candidato de Alto Desempenho</p>
                  </div>
                </div>
                <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 border border-emerald-100 text-[8px] font-bold rounded uppercase">Ativo</span>
              </div>

              <!-- Animated Scan list -->
              <div class="space-y-2.5 relative">
                <!-- Overlay scan line effect -->
                <div class="absolute left-0 w-full h-[60px] bg-gradient-to-b from-indigo-500/0 via-indigo-500/5 to-indigo-500/0 border-y border-indigo-500/10 opacity-80 animate-scan pointer-events-none"></div>
                
                <!-- Mock Contest item 1 -->
                <div class="bg-white border border-slate-100 rounded-xl p-3.5 flex justify-between items-center transition-all duration-500 hover:bg-slate-50 shadow-sm">
                  <div class="text-left space-y-1">
                    <span class="px-1.5 py-0.2 bg-blue-50 border border-blue-100 text-blue-600 text-[7px] font-bold rounded font-mono uppercase">VUNESP</span>
                    <h5 class="text-xs font-bold text-slate-800">Tribunal de Justiça SP</h5>
                    <p class="text-[9px] text-slate-400 font-medium">Cargo: Escrevente Técnico</p>
                  </div>
                  <div class="text-right space-y-1">
                    <span class="text-xs font-extrabold text-emerald-600">96% compatível</span>
                    <p class="text-[9px] text-indigo-600 font-bold">R$ 7.200,00</p>
                  </div>
                </div>

                <!-- Mock Contest item 2 -->
                <div class="bg-white border border-slate-100 rounded-xl p-3.5 flex justify-between items-center opacity-60">
                  <div class="text-left space-y-1">
                    <span class="px-1.5 py-0.2 bg-purple-50 border border-purple-100 text-purple-600 text-[7px] font-bold rounded font-mono uppercase">FGV</span>
                    <h5 class="text-xs font-bold text-slate-800">Senado Federal</h5>
                    <p class="text-[9px] text-slate-400 font-medium">Cargo: Analista Legislativo</p>
                  </div>
                  <div class="text-right space-y-1">
                    <span class="text-xs font-extrabold text-indigo-600">91% compatível</span>
