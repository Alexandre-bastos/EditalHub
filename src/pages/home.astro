    cargos: [{ nome_cargo: "Auditor de Controle Externo", quantidade: 20 }]
  }
];

// Mescla concursos do banco com concursos fictícios se houver poucos dados no banco
const listagemFinal = [...concursosVigentes.map(c => ({
  id: c.id,
  nome_concurso: c.nome_concurso,
  estado: c.estado || "N/A",
  escolaridade: c.escolaridade || "Superior",
  salario_inicial: c.salario_inicial ? Number(c.salario_inicial) : 0,
  taxa_inscricao: c.taxa_inscricao ? Number(c.taxa_inscricao) : 0,
  inscricao_inicio: c.inscricao_inicio ? new Date(c.inscricao_inicio).toISOString().split('T')[0] : '',
  inscricao_fim: c.inscricao_fim ? new Date(c.inscricao_fim).toISOString().split('T')[0] : '',
  data_prova: c.data_prova ? new Date(c.data_prova).toISOString().split('T')[0] : '',
  link_inscricao: c.link_inscricao || '#',
  edital: { organizadora: { nome: c.edital?.organizadora?.nome || 'FGV' } },
  resumo: c.resumo || 'Concurso público processado com inteligência pelo EditalHub.',
  compatibilidade: Math.floor(Math.random() * 9) + 90, // 90% a 98%
  area: c.formacao || 'Diversas',
  cargos: (c.cargos || []).map((cg: any) => ({ nome_cargo: cg.nome_cargo, quantidade: cg.quantidade || 1 }))
})), ...mockConcursos];

// Contadores agregados dinâmicos baseados na lista agregada
const totalEncontrados = listagemFinal.length;
const maxSalario = Math.max(...listagemFinal.map(c => c.salario_inicial));
const inscricoesAbertas = listagemFinal.filter(c => c.inscricao_fim !== '').length;
const previstosMes = Math.floor(totalEncontrados * 0.25) + 3;

// Verifica se o usuário já está logado
const user = Astro.locals.user;
---

<!doctype html>
<html lang="pt-br" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Existe um concurso ideal para você. Descubra agora com a inteligência do EditalHub." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>EditalHub | Encontre seu Concurso Ideal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#070708] text-gray-100 font-inter min-h-screen relative overflow-x-hidden selection:bg-blue-600/30 selection:text-blue-200">
    
    <!-- Elementos decorativos em degrade de fundo (Premium Glow System) -->
    <div class="absolute top-[-10%] left-[-20%] w-[60%] h-[60%] rounded-full bg-blue-900/10 blur-[180px] -z-10 animate-pulse"></div>
    <div class="absolute top-[40%] right-[-20%] w-[60%] h-[60%] rounded-full bg-indigo-900/10 blur-[180px] -z-10"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-950/10 blur-[150px] -z-10"></div>

    <!-- Barra de Navegação Header -->
    <header class="w-full border-b border-white/5 bg-[#070708]/60 backdrop-blur-md sticky top-0 z-40 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <div class="flex items-center gap-2">
          <span class="text-2xl font-outfit font-extrabold bg-gradient-to-r from-blue-400 via-indigo-400 to-indigo-500 bg-clip-text text-transparent tracking-tight">
            EditalHub
          </span>
          <span class="px-2 py-0.5 bg-blue-500/10 text-blue-400 text-[8px] font-bold rounded border border-blue-500/20 uppercase tracking-widest font-mono select-none">AI BETA</span>
        </div>
        
        <nav class="flex items-center gap-6">
          <a href="#simulator" class="text-xs font-semibold text-gray-400 hover:text-white transition-colors">Simulador</a>
          <a href="#how-it-works" class="text-xs font-semibold text-gray-400 hover:text-white transition-colors">Como Funciona</a>
          
          {user ? (
            <a 
              href="/dashboard" 
              class="text-xs bg-indigo-500 hover:bg-indigo-600 text-white px-5 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-indigo-900/30 flex items-center gap-1.5 active:scale-95"
            >
              Acessar Painel
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            </a>
          ) : (
            <div class="flex items-center gap-4">
              <a href="/login" class="text-xs font-bold text-white hover:text-blue-400 transition-colors">Entrar</a>
              <a 
                href="/cadastro" 
                class="text-xs bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-blue-600/20 flex items-center gap-1.5 active:scale-95"
              >
                Cadastrar Grátis
              </a>
            </div>
          )}
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-12 space-y-24">
      
      <!-- 1. Hero Principal -->
      <section class="text-center space-y-8 max-w-4xl mx-auto py-8">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/5 border border-blue-500/10 text-[10px] font-semibold text-blue-400 uppercase tracking-widest animate-pulse">
            ✨ Processamento Inteligente em Tempo Real
          </div>
          <h1 class="text-5xl md:text-6xl font-outfit font-extrabold text-white tracking-tight leading-none">
            Existe um concurso ideal para você. <br/>
            <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-indigo-500 bg-clip-text text-transparent">Descubra agora.</span>
          </h1>
          <p class="text-base text-gray-400 max-w-2xl mx-auto leading-relaxed">
            Mesmo que você esteja começando hoje, nossa inteligência varre os diários oficiais e editais do Brasil para encontrar oportunidades sob medida para sua carreira e formação.
          </p>
        </div>

        <!-- Campo Interativo Imediato -->
        <div class="bg-[#0f0f12]/60 border border-white/5 p-8 rounded-3xl backdrop-blur-md shadow-2xl space-y-6 max-w-2xl mx-auto">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Qual o seu nível de escolaridade atual?</h3>
          
          <div class="flex flex-wrap justify-center gap-3" id="school-filters">
            <button data-level="Ensino Fundamental" class="px-5 py-3 rounded-xl bg-white/[0.03] hover:bg-blue-600/10 hover:border-blue-500/30 border border-white/5 text-sm font-medium transition-all cursor-pointer active:scale-95">
              Ensino Fundamental
            </button>
            <button data-level="Ensino Médio" class="px-5 py-3 rounded-xl bg-white/[0.03] hover:bg-blue-600/10 hover:border-blue-500/30 border border-white/5 text-sm font-medium transition-all cursor-pointer active:scale-95">
              Ensino Médio
            </button>
            <button data-level="Técnico" class="px-5 py-3 rounded-xl bg-white/[0.03] hover:bg-blue-600/10 hover:border-blue-500/30 border border-white/5 text-sm font-medium transition-all cursor-pointer active:scale-95">
              Ensino Técnico
            </button>
            <button data-level="Superior" class="px-5 py-3 rounded-xl bg-white/[0.03] hover:bg-blue-600/10 hover:border-blue-500/30 border border-white/5 text-sm font-medium transition-all cursor-pointer active:scale-95">
              Ensino Superior
            </button>
            <button data-level="Pós-graduação" class="px-5 py-3 rounded-xl bg-white/[0.03] hover:bg-blue-600/10 hover:border-blue-500/30 border border-white/5 text-sm font-medium transition-all cursor-pointer active:scale-95">
              Pós-graduação
            </button>
          </div>
        </div>
      </section>

      <!-- 2. Experiência Instantânea (Exibida dinamicamente ao clicar nos filtros) -->
      <section id="results-section" class="scroll-mt-28 hidden transition-all duration-700 ease-out space-y-12">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-outfit font-extrabold text-white">Análise Instantânea do Seu Perfil</h2>
          <p class="text-sm text-gray-500">Concursos e estatísticas filtradas para o perfil: <span id="current-level-tag" class="font-bold text-blue-400">Superior</span></p>
        </div>

        <!-- Estatísticas Instantâneas -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="bg-[#0f0f12]/40 border border-white/5 p-6 rounded-2xl flex flex-col gap-1.5 shadow-xl relative overflow-hidden group hover:border-blue-500/20 transition-all">
            <span class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Compatíveis Encontrados</span>
            <span class="text-3xl font-outfit font-bold text-white transition-all" id="stat-encontrados">0</span>
            <div class="absolute top-0 right-0 w-16 h-16 bg-blue-500/5 rounded-bl-full group-hover:bg-blue-500/10 transition-all"></div>
          </div>
          <div class="bg-[#0f0f12]/40 border border-white/5 p-6 rounded-2xl flex flex-col gap-1.5 shadow-xl relative overflow-hidden group hover:border-blue-500/20 transition-all">
            <span class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Salários Máximos Até</span>
            <span class="text-3xl font-outfit font-bold text-emerald-400" id="stat-salario">R$ 0</span>
            <div class="absolute top-0 right-0 w-16 h-16 bg-emerald-500/5 rounded-bl-full group-hover:bg-emerald-500/10 transition-all"></div>
          </div>
          <div class="bg-[#0f0f12]/40 border border-white/5 p-6 rounded-2xl flex flex-col gap-1.5 shadow-xl relative overflow-hidden group hover:border-blue-500/20 transition-all">
            <span class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Inscrições Abertas</span>
            <span class="text-3xl font-outfit font-bold text-indigo-400" id="stat-abertas">0</span>
            <div class="absolute top-0 right-0 w-16 h-16 bg-indigo-500/5 rounded-bl-full group-hover:bg-indigo-500/10 transition-all"></div>
          </div>
          <div class="bg-[#0f0f12]/40 border border-white/5 p-6 rounded-2xl flex flex-col gap-1.5 shadow-xl relative overflow-hidden group hover:border-blue-500/20 transition-all">
            <span class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Concursos Previstos</span>
            <span class="text-3xl font-outfit font-bold text-amber-400" id="stat-previstos">0</span>
            <div class="absolute top-0 right-0 w-16 h-16 bg-amber-500/5 rounded-bl-full group-hover:bg-amber-500/10 transition-all"></div>
          </div>
        </div>

        <!-- 3. Cards Preview Inteligentes -->
        <div class="space-y-6">
          <div class="flex justify-between items-center">
            <h3 class="text-lg font-outfit font-bold text-white">Recomendações em Destaque</h3>
            <span class="text-xs text-gray-500 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              Atualizado em tempo real
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="contest-cards-container">
            <!-- Os cards serão injetados dinamicamente via JS client-side com total agilidade -->
          </div>
        </div>
      </section>

      <!-- 4. Simulador Motivacional -->
      <section id="simulator" class="bg-[#0c0c0e]/80 border border-white/5 p-8 md:p-12 rounded-3xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-96 h-96 bg-blue-900/5 rounded-full blur-[100px] -z-10"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/5 border border-indigo-500/10 text-[9px] font-bold text-indigo-400 uppercase tracking-widest">
              ⚡ Teste Seu Potencial
            </div>
            <h2 class="text-3xl md:text-4xl font-outfit font-extrabold text-white leading-tight">
              Seu futuro pode começar agora. Faça uma simulação rápida.
            </h2>
            <p class="text-sm text-gray-400 leading-relaxed">
              Muitos concurseiros perdem oportunidades excelentes simplesmente por não saberem que a formação deles atende aos requisitos de certames abertos. Descubra quantos editais te aguardam agora.
            </p>
          </div>

          <!-- Form de Simulação -->
          <div class="bg-[#111114]/80 border border-white/5 p-6 rounded-2xl space-y-5">
            <div>
              <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Selecione sua Escolaridade</label>
              <select id="sim-school" class="w-full bg-[#16161a] border border-white/5 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500/40">
                <option value="Ensino Fundamental">Ensino Fundamental</option>
                <option value="Ensino Médio" selected>Ensino Médio</option>
                <option value="Técnico">Ensino Técnico</option>
                <option value="Superior">Ensino Superior</option>
                <option value="Pós-graduação">Pós-graduação</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Seu Estado (UF)</label>
              <select id="sim-state" class="w-full bg-[#16161a] border border-white/5 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500/40">
                <option value="Todos">Todos os Estados</option>
                <option value="RJ">Rio de Janeiro</option>
                <option value="SP">São Paulo</option>
                <option value="MG">Minas Gerais</option>
                <option value="DF">Distrito Federal</option>
                <option value="SC">Santa Catarina</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Área de Interesse</label>
              <select id="sim-area" class="w-full bg-[#16161a] border border-white/5 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500/40">
                <option value="Todas">Todas as Áreas</option>
                <option value="Policial">Carreira Policial</option>
                <option value="Fiscal">Área Fiscal / Contas</option>
                <option value="Tribunais">Tribunais / Judiciária</option>
                <option value="Bancária">Bancária / Financeira</option>
                <option value="Educação">Educação / Ensino</option>
                <option value="Saúde">Saúde / Médica</option>
