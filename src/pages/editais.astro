---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import prisma from '../lib/prisma';
import { azureStorage } from '../services/azureStorage';
import { createAuditLog } from '../services/audit';

const currentUser = Astro.locals.user;
if (!currentUser) {
  return Astro.redirect('/login');
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();
    const editalId = formData.get('editalId')?.toString();

    if (action === 'delete' && editalId) {
      // 1. Buscar edital
      const edital = await prisma.edital.findUnique({
        where: { id: editalId },
        include: { concursos: true }
      });

      if (edital) {
        // 2. Se possuir arquivo, remover do storage
        if (edital.nome_arquivo) {
          console.log(`[Exclusão] Excluindo PDF do Blob: ${edital.nome_arquivo}`);
          await azureStorage.deleteBlob(edital.nome_arquivo);
        }

        // 3. Excluir cargos (vagas) vinculadas aos concursos do edital
        for (const concurso of edital.concursos) {
          await prisma.vaga.deleteMany({
            where: { concurso_id: concurso.id }
          });
        }

        // 4. Excluir concursos vinculados
        await prisma.concurso.deleteMany({
          where: { edital_id: editalId }
        });

        // 5. Excluir o edital do banco
        await prisma.edital.delete({
          where: { id: editalId }
        });

        // 6. Registrar auditoria
        await createAuditLog(
          currentUser.id,
          currentUser.nome,
          'Excluiu Edital',
          'Edital',
          editalId,
          `Excluiu definitivamente o edital "${edital.nome_edital}" e removeu seu PDF do storage.`
        );

        return Astro.redirect('/editais');
      }
    }
  } catch (err: any) {
    console.error('Erro ao excluir edital:', err);
    errorMessage = 'Falha ao excluir edital: ' + err.message;
  }
}

const editais = await prisma.edital.findMany({
  where: { 
    is_valido: true
  },
  orderBy: { data_download: 'desc' },
  include: { 
    organizadora: true,
    concursos: true
  }
});
---

<DashboardLayout title="Monitoramento de Editais">
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-2xl font-outfit font-bold text-gray-100">Repositório de Editais</h2>
      <p class="text-sm text-gray-500">Gerencie a coleta automatizada e as entradas manuais</p>
    </div>
    <div class="flex gap-3">
      <a href="/editais/novo" class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-bold rounded-xl transition-all shadow-lg shadow-blue-600/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Cadastrar Manualmente
      </a>
      <button id="sync-btn" class="flex items-center gap-2 px-5 py-2.5 bg-white/5 hover:bg-white/10 text-gray-300 text-sm font-bold rounded-xl transition-all border border-white/10">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
        Sincronizar Bancas
      </button>
    </div>
  </div>

  {errorMessage && (
    <div class="bg-red-500/10 border border-red-500/20 text-red-500 px-4 py-3 rounded-xl mb-6 text-sm flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{errorMessage}</span>
    </div>
  )}

  <div class="glass-card overflow-hidden">
    <div class="px-6 py-4 border-b border-white/5 bg-white/[0.01]">
      <div class="flex justify-between items-center">
        <h3 class="font-outfit font-semibold text-xs uppercase tracking-widest text-gray-500">Editais Vigentes</h3>
        <span class="text-[10px] font-bold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-full">{editais.length} ativos</span>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="text-[10px] text-gray-500 uppercase tracking-widest bg-white/[0.02]">
            <th class="px-6 py-4 font-medium">Concurso / Órgão</th>
            <th class="px-6 py-4 font-medium">Banca</th>
            <th class="px-6 py-4 font-medium">Data Coleta</th>
            <th class="px-6 py-4 font-medium">Status IA</th>
            <th class="px-6 py-4 font-medium text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {editais.map(edital => (
            <tr class="hover:bg-white/[0.01] transition-colors group">
              <td class="px-6 py-4">
                <p class="text-sm font-semibold text-gray-200 group-hover:text-blue-400 transition-colors flex items-center gap-2">
                  {edital.concursos[0]?.nome_concurso || edital.nome_edital}
                  {edital.data_download && (new Date().getTime() - new Date(edital.data_download).getTime()) < (24 * 60 * 60 * 1000) && (
                    <span class="inline-flex items-center px-1.5 py-0.5 bg-gradient-to-r from-emerald-500 to-teal-400 text-[#070708] text-[8px] font-extrabold rounded shadow-[0_0_8px_rgba(52,211,153,0.35)] animate-pulse uppercase tracking-wider shrink-0">
                      Novo
                    </span>
                  )}
                </p>
                <div class="flex items-center gap-2 mt-1">
                   <p class="text-[10px] text-gray-500 truncate max-w-[250px]" title={edital.url_edital}>{edital.url_edital}</p>
                </div>
              </td>

              <td class="px-6 py-4">
                <span class="px-2 py-0.5 bg-blue-500/10 text-blue-400 text-[9px] font-bold rounded-full border border-blue-500/20">
                  {edital.organizadora.nome}
                </span>
              </td>
              <td class="px-6 py-4 text-[11px] text-gray-400 font-mono">
                {edital.data_download ? new Date(edital.data_download).toLocaleString('pt-BR') : '-'}
              </td>
              <td class="px-6 py-4">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center gap-2">
                    <span class={`w-1.5 h-1.5 rounded-full ${
                      edital.status_processamento === 'pendente' ? 'bg-amber-500 animate-pulse' : 
                      edital.status_processamento === 'erro' ? 'bg-red-500' :
                      'bg-green-500'
                    }`}></span>
                    <span class={`text-[9px] font-bold uppercase tracking-tight ${
                      edital.status_processamento === 'pendente' ? 'text-amber-500' : 
                      edital.status_processamento === 'erro' ? 'text-red-500' :
                      'text-green-500'
                    }`}>
                      {edital.status_processamento}
                    </span>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <!-- Link para Gestão de Dados (Manual ou Extraído) -->
                  <a 
                    href={edital.concursos.length > 0 ? `/concursos/${edital.concursos[0].id}` : `/concursos/manual?edital=${edital.id}`}
                    class="p-2 bg-blue-500/10 hover:bg-blue-400 text-blue-400 hover:text-white rounded-lg transition-all border border-blue-500/10"
                    title="Gerenciar Dados e Cargos"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/><path d="M8 6h5"/><path d="M8 10h9"/><path d="M8 14h5"/><path d="M8 18h9"/></svg>
                  </a>

                  {edital.nome_arquivo && (edital.status_processamento === 'pendente' || edital.status_processamento === 'erro') && (
                    <button 
                      class="process-btn p-2 bg-indigo-600/10 hover:bg-indigo-600 text-indigo-400 hover:text-white rounded-lg transition-all border border-indigo-600/20"
                      data-id={edital.id}
                      title={edital.status_processamento === 'erro' ? 'Reprocessar' : 'Processar com IA'}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                    </button>
                  )}
                  {edital.nome_arquivo && (
                    <a 
                      href={`https://storageappvidanavida.blob.core.windows.net/editalhub/${edital.nome_arquivo}`} 
                      target="_blank"
                      class="p-2 bg-white/5 hover:bg-red-500/10 rounded-lg text-gray-500 hover:text-red-400 transition-all"
                      title="Abrir PDF"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14.5 2 14.5 7 20 7"/></svg>
                    </a>
                  )}

                  <form method="POST" onsubmit="return confirm('Tem certeza que deseja excluir definitivamente este edital? Esta ação é irreversível e removerá todos os concursos/cargos vinculados, além de deletar o arquivo PDF na Azure.');" class="inline">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="editalId" value={edital.id} />
                    <button type="submit" class="p-2 bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white rounded-lg transition-all border border-red-500/10" title="Excluir Edital">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const processBtns = document.querySelectorAll('.process-btn');
    processBtns.forEach(btn => {
      btn.addEventListener('click', async () => {
        const editalId = btn.getAttribute('data-id');
        btn.setAttribute('disabled', 'true');
        btn.classList.add('animate-pulse');
        
        try {
          const res = await fetch('/api/process', {
            method: 'POST',
            body: JSON.stringify({ editalId }),
            headers: { 'Content-Type': 'application/json' }
          });
          if (res.ok) {
            if (typeof (window as any).startPoller === 'function') {
              (window as any).startPoller();
            } else {
              window.location.reload();
            }
          } else {
            const data = await res.json();
            alert('Falha: ' + (data.error || 'Erro desconhecido'));
            btn.removeAttribute('disabled');
            btn.classList.remove('animate-pulse');
          }
        } catch (err) {
          alert('Erro na rede');
          btn.removeAttribute('disabled');
          btn.classList.remove('animate-pulse');
        }
      });
    });

    const syncBtn = document.getElementById('sync-btn');
    syncBtn?.addEventListener('click', async () => {
      syncBtn.setAttribute('disabled', 'true');
      const originalHtml = syncBtn.innerHTML;
      syncBtn.innerHTML = 'Disparando...';
      
      try {
        const res = await fetch('/api/collect', { method: 'POST' });
        if (res.ok) {
          if (typeof (window as any).startPoller === 'function') {
            (window as any).startPoller();
          } else {
            window.location.reload();
          }
        } else {
          alert('Erro ao sincronizar');
          syncBtn.removeAttribute('disabled');
          syncBtn.innerHTML = originalHtml;
        }
      } catch (err) {
        alert('Erro na rede');
        syncBtn.removeAttribute('disabled');
        syncBtn.innerHTML = originalHtml;
      }
    });
  </script>
</DashboardLayout>
