---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

// Obtém o usuário logado do middleware Astro.locals
const user = Astro.locals.user;
const userName = user?.nome || 'Usuário';
const userEmail = user?.email || 'admin@editalhub.com';

// Calcula as iniciais do usuário
const userInitials = userName
  .split(' ')
  .filter(Boolean)
  .map(n => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase() || 'U';
---
<!doctype html>
<html lang="pt-br" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="EditalHub - Gestão Inteligente de Editais" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | EditalHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#fafafc] text-slate-800 font-inter min-h-screen flex antialiased">
    
    <!-- Sidebar -->
    <aside class="w-64 border-r border-slate-200/60 bg-white flex flex-col fixed h-full shadow-[2px_0_15px_rgba(15,23,42,0.01)]">
      <div class="p-6">
        <h1 class="text-2xl font-outfit font-extrabold bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 bg-clip-text text-transparent tracking-tight">
          Edital<span class="text-indigo-600">Hub</span>
        </h1>
        <p class="text-[10px] text-slate-400 uppercase tracking-widest mt-1 font-bold">Inteligência em Concursos</p>
      </div>

      <nav class="flex-1 px-4 space-y-2">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50 transition-all text-slate-500 hover:text-slate-900 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-indigo-600"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
          <span class="font-semibold">Dashboard</span>
        </a>
        <a href="/organizadoras" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50 transition-all text-slate-500 hover:text-slate-900 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-indigo-600"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="9" y1="22" x2="9" y2="16"/><line x1="15" y1="22" x2="15" y2="16"/><line x1="9" y1="16" x2="15" y2="16"/><path d="M8 6h2"/><path d="M14 6h2"/><path d="M8 10h2"/><path d="M14 10h2"/></svg>
          <span class="font-semibold">Bancas</span>
        </a>
        <a href="/editais" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50 transition-all text-slate-500 hover:text-slate-900 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-indigo-600"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14.5 2 14.5 7 20 7"/></svg>
          <span class="font-semibold">Editais</span>
        </a>
        <a href="/usuarios" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-50 transition-all text-slate-500 hover:text-slate-900 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-indigo-600"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="font-semibold">Usuários</span>
        </a>
      </nav>

      <!-- Rodapé da Sidebar: Perfil do Usuário com Logout Dinâmico -->
      <div class="p-4 border-t border-slate-100">
        <div class="flex items-center justify-between gap-3 px-2 py-2">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-xs shrink-0 select-none text-white shadow-md shadow-indigo-200">
              {userInitials}
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-slate-800 truncate" title={userName}>{userName}</p>
              <p class="text-[9px] text-slate-400 font-mono truncate" title={userEmail}>{userEmail}</p>
            </div>
          </div>
          <a 
            href="/logout" 
            class="text-slate-400 hover:text-red-600 hover:bg-red-50 p-1.5 rounded-lg transition-all shrink-0 cursor-pointer"
            title="Sair do Painel"
            onclick="return confirm('Deseja realmente sair da sua sessão?');"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-8">
      <header class="flex justify-between items-center mb-10">
        <div>
          <h2 class="text-2xl font-outfit font-extrabold text-slate-900 tracking-tight">{title}</h2>
          <p class="text-sm text-slate-500 font-light">Bem-vindo ao centro de controle do EditalHub.</p>
        </div>
        <div class="flex gap-4">
          <button id="run-collector" class="bg-white hover:bg-slate-50 text-slate-700 px-5 py-2.5 rounded-xl font-semibold transition-all flex items-center gap-2 border border-slate-200 shadow-sm active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/><polyline points="22 4 22 10 16 10"/></svg>
            Sincronizar Bancas
          </button>
          <button id="run-processor" class="bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2.5 rounded-xl font-bold transition-all flex items-center gap-2 shadow-md shadow-indigo-100 hover:shadow-lg active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
            Processar com IA
          </button>
        </div>
      </header>

      <slot />
    </main>


    <!-- Floating Sync Status Widget (Premium Light Theme Toast) -->
    <div id="sync-status-widget" class="fixed bottom-6 right-6 z-50 bg-white/95 border border-indigo-100 px-5 py-4 rounded-2xl shadow-[0_10px_35px_rgba(99,102,241,0.08)] max-w-sm w-80 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-500 ease-out flex gap-3.5 items-start">
      <div class="flex-shrink-0 mt-0.5" id="sync-widget-icon-container">
        <!-- Spinner Loader Animado -->
        <div class="w-5 h-5 rounded-full border-2 border-indigo-500/20 border-t-indigo-600 animate-spin"></div>
      </div>
      <div class="flex-1 min-w-0">
        <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-0.5" id="sync-widget-title">Sincronização Ativa</h4>
        <p class="text-xs text-slate-500 leading-relaxed font-medium" id="sync-widget-message">Verificando status...</p>
        
        <!-- Barra de Progresso Fina -->
        <div class="w-full bg-slate-100 h-1 rounded-full mt-2.5 overflow-hidden">
          <div id="sync-widget-progress" class="bg-gradient-to-r from-indigo-500 to-blue-600 h-full rounded-full w-full animate-pulse transition-all duration-1000"></div>
        </div>
      </div>
    </div>

    <!-- Sync Summary Modal (Premium Light Theme Overlay) -->
    <div id="sync-summary-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300">
      <div class="bg-white border border-slate-200 rounded-3xl p-8 max-w-md w-full mx-4 shadow-2xl transform scale-95 transition-all duration-300">
        <div class="flex items-center gap-3 mb-4">
          <div class="p-2.5 bg-emerald-50 rounded-xl text-emerald-600 border border-emerald-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3 class="text-xl font-outfit font-extrabold text-slate-900">Sincronização Concluída</h3>
        </div>
        
        <p class="text-sm text-slate-500 mb-6 leading-relaxed font-light">
          O processo de varredura nos portais e processamento com Inteligência Artificial foi finalizado. Confira o resumo do que foi modificado na base de dados:
        </p>
        
        <div class="space-y-3.5 mb-6 bg-slate-50 border border-slate-200/60 rounded-2xl p-5 font-inter">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500 flex items-center gap-2 font-medium">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              Editais Coletados (Novos)
            </span>
            <span class="font-bold font-mono text-slate-800" id="summary-valid">0</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500 flex items-center gap-2 font-medium">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Processados com IA (Vagas extraídas)
            </span>
            <span class="font-bold font-mono text-emerald-600" id="summary-processed">0</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500 flex items-center gap-2 font-medium">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              Erros de Processamento (IA)
            </span>
            <span class="font-bold font-mono text-red-500" id="summary-failed">0</span>
          </div>
          <div class="flex justify-between items-center text-sm border-t border-slate-200 pt-2 mt-2">
            <span class="text-slate-400 flex items-center gap-2 font-medium">
              <span class="w-2 h-2 rounded-full bg-slate-400"></span>
              Arquivos Filtrados / Descartados
            </span>
            <span class="font-bold font-mono text-slate-500" id="summary-ignored">0</span>
          </div>
        </div>
        
        <button id="close-summary-btn" class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-extrabold rounded-xl transition-all shadow-md active:scale-[0.98] uppercase tracking-wider text-xs cursor-pointer">
          Entendido (OK)
        </button>
      </div>
    </div>

    <!-- Sync Error Modal (Premium Light Theme Overlay) -->
    <div id="sync-error-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300">
      <div class="bg-white border border-red-100 rounded-3xl p-8 max-w-md w-full mx-4 shadow-2xl transform scale-95 transition-all duration-300">
        <div class="flex items-center gap-3 mb-4">
          <div class="p-2.5 bg-red-50 rounded-xl text-red-600 border border-red-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h3 class="text-xl font-outfit font-extrabold text-slate-900">Falha na Sincronização</h3>
        </div>
        
        <p class="text-sm text-slate-500 mb-4 leading-relaxed font-light">
          Ocorreu um erro crítico durante o processo. A operação foi interrompida com segurança. Detalhes técnicos do erro:
        </p>
        
        <div class="bg-red-50 border border-red-100 rounded-2xl p-5 mb-6">
          <p id="sync-error-details" class="text-xs text-red-700 font-mono leading-relaxed break-words whitespace-pre-wrap select-all">
            Nenhum detalhe adicional fornecido.
          </p>
        </div>
        
        <button id="close-error-btn" class="w-full py-3.5 bg-red-600 hover:bg-red-500 text-white font-extrabold rounded-xl transition-all shadow-md active:scale-[0.98] uppercase tracking-wider text-xs cursor-pointer">
          Recarregar Painel
        </button>
      </div>
    </div>

    <script>
      let isPollerActive = false;
      let pollerIntervalId: any = null;
      let lastActiveState = false;

      // Elementos do Widget
      const widget = document.getElementById('sync-status-widget');
      const widgetIcon = document.getElementById('sync-widget-icon-container');
      const widgetTitle = document.getElementById('sync-widget-title');
      const widgetMessage = document.getElementById('sync-widget-message');
      const widgetProgress = document.getElementById('sync-widget-progress');

      // Botões no layout
      const runBtn = document.getElementById('run-collector');
      const processBtn = document.getElementById('run-processor');

      function getAllSyncButtons() {
        return document.querySelectorAll('#run-collector, #sync-btn, #run-processor, .process-btn');
      }

      function disableAllButtons(disable: boolean) {
        const buttons = getAllSyncButtons();
        buttons.forEach(btn => {
          if (disable) {
            btn.setAttribute('disabled', 'true');
            btn.classList.add('opacity-40', 'pointer-events-none');
          } else {
            btn.removeAttribute('disabled');
            btn.classList.remove('opacity-40', 'pointer-events-none');
          }
        });

        const syncOrgSelect = document.getElementById('sync-org-select');
        if (syncOrgSelect) {
          if (disable) {
            syncOrgSelect.setAttribute('disabled', 'true');
            syncOrgSelect.classList.add('opacity-40', 'pointer-events-none');
          } else {
            syncOrgSelect.removeAttribute('disabled');
            syncOrgSelect.classList.remove('opacity-40', 'pointer-events-none');
          }
        }
      }

      function showWidget(stage: string, message: string) {
        if (!widget) return;
        
        // Exibe o widget
        widget.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        widget.classList.add('translate-y-0', 'opacity-100');
        
        // Estilos padrão de atividade (azul)
        widget.classList.remove('border-green-500/30', 'border-red-500/30');
        widget.classList.add('border-blue-500/20');

        if (widgetProgress) {
          widgetProgress.classList.remove('bg-emerald-500', 'bg-red-500', 'w-full');
          widgetProgress.classList.add('bg-gradient-to-r', 'from-blue-500', 'to-indigo-600', 'animate-pulse');
          if (stage === 'scraping') {
            widgetProgress.style.width = '30%';
          } else {
            widgetProgress.style.width = '75%';
          }
        }

        if (widgetIcon) {
          widgetIcon.innerHTML = `<div class="w-5 h-5 rounded-full border-2 border-blue-500/20 border-t-blue-500 animate-spin"></div>`;
        }

        if (widgetTitle) {
          widgetTitle.innerText = stage === 'scraping' ? 'Buscando Editais' : 'Processamento IA';
          widgetTitle.classList.remove('text-green-400', 'text-red-400');
          widgetTitle.classList.add('text-white');
        }

        if (widgetMessage) {
          widgetMessage.innerText = message;
        }

        disableAllButtons(true);
      }

      function showWidgetSuccess(summary: any) {
        if (!widget) return;

        if (widgetIcon) {
          widgetIcon.innerHTML = `
            <svg class="text-green-400 w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          `;
        }

        if (widgetTitle) {
          widgetTitle.innerText = 'Sincronizado!';
          widgetTitle.classList.remove('text-white', 'text-red-400');
          widgetTitle.classList.add('text-green-400');
        }

        if (widgetMessage) {
          widgetMessage.innerText = 'Processo concluído com sucesso!';
        }

        if (widgetProgress) {
          widgetProgress.classList.remove('from-blue-500', 'to-indigo-600', 'animate-pulse', 'bg-red-500');
          widgetProgress.classList.add('bg-emerald-500');
          widgetProgress.style.width = '100%';
        }

        widget.classList.remove('border-blue-500/20', 'border-red-500/30');
        widget.classList.add('border-green-500/30');

        // Preenche os dados no modal
        const modal = document.getElementById('sync-summary-modal');
        const modalContent = modal?.querySelector('div');
        const validEl = document.getElementById('summary-valid');
        const processedEl = document.getElementById('summary-processed');
        const failedEl = document.getElementById('summary-failed');
        const ignoredEl = document.getElementById('summary-ignored');

        if (summary) {
          if (validEl) validEl.innerText = summary.valid ?? '0';
          if (processedEl) processedEl.innerText = summary.processed ?? '0';
          if (failedEl) failedEl.innerText = summary.failed ?? '0';
          if (ignoredEl) ignoredEl.innerText = summary.ignored ?? '0';
        }

        // Abre o modal com uma animação de fade e escala suave
        setTimeout(() => {
          if (modal && modalContent) {
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-95');
            modalContent.classList.add('scale-100');
          }
        }, 1000);
      }

      function showWidgetError(errorMessage: string) {
        if (!widget) return;

        if (widgetIcon) {
          widgetIcon.innerHTML = `
            <svg class="text-red-400 w-5 h-5 animate-bounce" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          `;
        }

        if (widgetTitle) {
          widgetTitle.innerText = 'Falha no Sync!';
          widgetTitle.classList.remove('text-white', 'text-green-400');
          widgetTitle.classList.add('text-red-400');
        }

        if (widgetMessage) {
          widgetMessage.innerText = 'A sincronização foi interrompida.';
        }

        if (widgetProgress) {
          widgetProgress.classList.remove('from-blue-500', 'to-indigo-600', 'animate-pulse', 'bg-emerald-500');
          widgetProgress.classList.add('bg-red-500');
          widgetProgress.style.width = '100%';
        }

        widget.classList.remove('border-blue-500/20', 'border-green-500/30');
        widget.classList.add('border-red-500/30');

        // Preenche os dados no modal de erro
        const modal = document.getElementById('sync-error-modal');
        const modalContent = modal?.querySelector('div');
        const detailsEl = document.getElementById('sync-error-details');

        if (detailsEl) {
          detailsEl.innerText = errorMessage || 'Nenhum detalhe adicional disponível.';
        }

        // Abre o modal de erro com uma animação de fade e escala suave
        setTimeout(() => {
          if (modal && modalContent) {
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-95');
            modalContent.classList.add('scale-100');
          }
        }, 1000);
      }

      function hideWidget() {
        if (!widget) return;
        widget.classList.remove('translate-y-0', 'opacity-100');
        widget.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        disableAllButtons(false);
      }

      async function checkSyncStatus() {
        try {
          const res = await fetch('/api/sync-status');
          if (!res.ok) return;
          
          const data = await res.json();
          
          if (data.active) {
            lastActiveState = true;
            showWidget(data.stage, data.message);
          } else {
            if (lastActiveState) {
              // Mudou de ativo para inativo agora: sucesso ou erro!
              lastActiveState = false;
              if (pollerIntervalId) clearInterval(pollerIntervalId);
              if (data.error) {
                showWidgetError(data.error);
              } else {
                showWidgetSuccess(data.summary);
              }
            } else {
              hideWidget();
            }
          }
        } catch (err) {
          console.error('Erro ao verificar status de sync:', err);
        }
      }

      // Inicia Polling em segundo plano
      function startPoller() {
        if (isPollerActive) return;
        isPollerActive = true;
        
        // Checagem imediata
        checkSyncStatus();
        
        // Checagens a cada 6 segundos
        pollerIntervalId = setInterval(checkSyncStatus, 6000);
      }

      // Expõe no objeto global window para uso em scripts de outras páginas
      (window as any).startPoller = startPoller;


      // Disparador de Coleta
      runBtn?.addEventListener('click', async () => {
        runBtn.setAttribute('disabled', 'true');
        const originalHtml = runBtn.innerHTML;
        runBtn.innerHTML = 'Disparando...';
        
        try {
          const res = await fetch('/api/collect', { method: 'POST' });
          if (res.ok) {
            // Inicia imediatamente o poller para dar feedback ao usuário
            startPoller();
          } else {
            let errorText = 'Falha ao disparar sincronização na Azure';
            try {
              const data = await res.json();
              if (data.error) {
                errorText = data.error;
              }
            } catch (e) {}
            
            showWidgetError(errorText);
            runBtn.removeAttribute('disabled');
            runBtn.innerHTML = originalHtml;
          }
        } catch (err) {
          showWidgetError(err instanceof Error ? err.message : 'Erro de rede ao iniciar sincronização');
          runBtn.removeAttribute('disabled');
          runBtn.innerHTML = originalHtml;
        }
      });

      // Disparador de Processamento em Lote
      processBtn?.addEventListener('click', async () => {
        processBtn.setAttribute('disabled', 'true');
        const originalHtml = processBtn.innerHTML;
        processBtn.innerHTML = 'Disparando...';
        
        try {
          const res = await fetch('/api/process', { method: 'POST' });
          if (res.ok) {
            // Inicia imediatamente o poller
            startPoller();
          } else {
            let errorText = 'Falha ao iniciar processamento na Azure';
            try {
              const data = await res.json();
              if (data.error) {
                errorText = data.error;
              }
            } catch (e) {}
            
            showWidgetError(errorText);
            processBtn.removeAttribute('disabled');
            processBtn.innerHTML = originalHtml;
          }
        } catch (err) {
          showWidgetError(err instanceof Error ? err.message : 'Erro de rede ao iniciar processamento');
          processBtn.removeAttribute('disabled');
          processBtn.innerHTML = originalHtml;
        }
      });

      // Ouvinte para o botão "Entendido (OK)" no modal de resumo
      const closeSummaryBtn = document.getElementById('close-summary-btn');
      closeSummaryBtn?.addEventListener('click', () => {
        const modal = document.getElementById('sync-summary-modal');
        const modalContent = modal?.querySelector('div');
        
        if (modal && modalContent) {
          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
          modal.classList.add('opacity-0', 'pointer-events-none');
        }
        
        // Recarrega a página para atualizar toda a lista e os novos editais e badges
        window.location.reload();
      });

      // Ouvinte para o botão "Recarregar Painel" no modal de erro
      const closeErrorBtn = document.getElementById('close-error-btn');
      closeErrorBtn?.addEventListener('click', () => {
        const modal = document.getElementById('sync-error-modal');
        const modalContent = modal?.querySelector('div');
        
        if (modal && modalContent) {
          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
          modal.classList.add('opacity-0', 'pointer-events-none');
        }
        
        window.location.reload();
      });

      // Inicialização: Se houver qualquer sync rodando ao carregar a página,
      // ativa automaticamente o widget flutuante e o poller
      startPoller();
    </script>
	</body>
</html>


